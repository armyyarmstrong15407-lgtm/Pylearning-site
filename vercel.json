// ── CONFETTI ──
function launchConfetti(){
  var canvas=document.getElementById('confetti-canvas');
  canvas.style.display='block';
  var ctx=canvas.getContext('2d');
  canvas.width=window.innerWidth; canvas.height=window.innerHeight;
  var pieces=[];
  for(var i=0;i<140;i++){
    pieces.push({x:Math.random()*canvas.width,y:-10,w:7+Math.random()*8,h:4+Math.random()*4,
      color:['#00e5ff','#7c3aed','#f59e0b','#10b981','#ef4444'][Math.floor(Math.random()*5)],
      rot:Math.random()*360,speed:2+Math.random()*4,drift:(Math.random()-.5)*2});
  }
  var frame;
  function draw(){
    ctx.clearRect(0,0,canvas.width,canvas.height);
    var alive=false;
    pieces.forEach(function(p){
      if(p.y<canvas.height) alive=true;
      ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot*Math.PI/180);
      ctx.fillStyle=p.color;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore();
      p.y+=p.speed;p.x+=p.drift;p.rot+=3;
    });
    if(alive) frame=requestAnimationFrame(draw);
    else{canvas.style.display='none';cancelAnimationFrame(frame);}
  }
  draw();
  setTimeout(function(){canvas.style.display='none';cancelAnimationFrame(frame);},5000);
}

