function startQuiz(topic,btn){
  document.querySelectorAll('.q-pill').forEach(function(p){p.classList.remove('active');});
  btn.classList.add('active');
  quizTopic=topic;
  quizQs=quizData[topic].slice().sort(function(){return Math.random()-.5;});
  quizIdx=0;quizScore=0;
  document.getElementById('scoreView').style.display='none';
  document.getElementById('quizContent').style.display='block';
  renderQuestion();
}
function renderQuestion(){
  answered=false;
  var q=quizQs[quizIdx];
  var total=quizQs.length;
  document.getElementById('qProgText').textContent='Question '+(quizIdx+1)+' of '+total;
  document.getElementById('qProgFill').style.width=(quizIdx/total*100)+'%';
  document.getElementById('qQuestion').textContent=q.q;
  document.getElementById('qFeedback').className='q-feedback';
  document.getElementById('qFeedback').textContent='';
  document.getElementById('qNextBtn').style.display='none';
  var letters=['A','B','C','D'];
  document.getElementById('qOptions').innerHTML=q.o.map(function(opt,i){
    return '<button class="q-opt" onclick="selectAnswer('+i+')">'
      +'<span class="opt-letter">'+letters[i]+'</span>'+opt+'</button>';
  }).join('');
}
function selectAnswer(i){
  if(answered) return; answered=true;
  var q=quizQs[quizIdx];
  var opts=document.querySelectorAll('.q-opt');
  opts.forEach(function(o){o.disabled=true;});
  opts[q.a].classList.add('correct');
  var fb=document.getElementById('qFeedback');
  if(i===q.a){
    quizScore++;
    fb.className='q-feedback correct-fb';
    fb.textContent='✅ Correct! '+q.e;
  } else {
    opts[i].classList.add('wrong');
    fb.className='q-feedback wrong-fb';
    fb.textContent='❌ Not quite. '+q.e;
  }
  document.getElementById('qNextBtn').style.display='block';
}
function nextQuestion(){
  quizIdx++;
  if(quizIdx>=quizQs.length) showScore();
  else renderQuestion();
}
function showScore(){
  document.getElementById('quizContent').style.display='none';
  var sv=document.getElementById('scoreView');
  sv.style.display='block';
  var pct=Math.round((quizScore/quizQs.length)*100);
  document.getElementById('scoreCircle').style.setProperty('--pct',pct+'%');
  document.getElementById('scoreText').textContent=quizScore+'/'+quizQs.length;
  document.getElementById('qProgFill').style.width='100%';
  var msgs=pct===100?['🏆 Perfect Score!','You nailed every question!']:pct>=80?['🎉 Excellent!','Great understanding!']:pct>=60?['👍 Good Job!','Review the missed ones and try again.']:['📚 Keep Studying','Go back to the lesson and try once more!'];
  document.getElementById('scoreMsg').textContent=msgs[0];
  document.getElementById('scoreSub').textContent=msgs[1];
  // Save history
  quizHistory.unshift({topic:quizTopic,score:quizScore,total:quizQs.length,pct:pct,date:new Date().toLocaleDateString()});
  quizHistory=quizHistory.slice(0,10);
  save('quizHistory',quizHistory);
  renderHistory();
  // XP
  addXP(quizScore*10,quizScore+'/'+quizQs.length+' on '+quizTopic);
  // Leaderboard
  var name=prompt('Enter your name for the leaderboard (Cancel to skip):');
  if(name&&name.trim()){
    leaderboard.push({name:name.trim(),score:quizScore+'/'+quizQs.length,topic:quizTopic,pct:pct});
    leaderboard.sort(function(a,b){return b.pct-a.pct;});
    leaderboard=leaderboard.slice(0,10);
    save('leaderboard',leaderboard);
    renderLeaderboard();
    showToast('🏆 Added to leaderboard!');
  }
}
