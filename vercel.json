// ── PLAYGROUND ──
function runPython(code, cb) {
  if (typeof Sk !== 'undefined' && Sk.misceval) {
    var output = '';
    try {
      Sk.configure({
        output: function(txt) { output += txt; },
        read: function(f) {
          if (Sk.builtinFiles && Sk.builtinFiles.files[f]) return Sk.builtinFiles.files[f];
          throw 'File not found: ' + f;
        },
        inputfun: function(pr) { return window.prompt(pr) || ''; },
        inputfunTakesPrompt: true
      });
      Sk.misceval.asyncToPromise(function() {
        return Sk.importMainWithBody('<stdin>', false, code, true);
      }).then(function() {
        cb(output || '(no output)');
      }).catch(function(e) {
        var msg = (e.args && e.args.v && e.args.v[0]) ? e.args.v[0].v : (e.toString ? e.toString() : String(e));
        cb('Error: ' + msg);
      });
      return;
    } catch(e) {
      cb('Error: ' + (e.toString ? e.toString() : String(e)));
      return;
    }
  }
  cb(pySimulate(code));
}

function pyStr(val) {
  if (val === null || val === undefined) return 'None';
  if (typeof val === 'boolean') return val ? 'True' : 'False';
  if (Array.isArray(val)) return '[' + val.map(pyStr).join(', ') + ']';
  return String(val);
}

function evalExpr(expr, vars) {
  expr = expr.trim();
  if (!expr) return null;
  if ((expr.startsWith('f"') || expr.startsWith("f'")) && expr.length > 3) {
    var q = expr[1];
    var inner = expr.slice(2, -1);
    return inner.replace(/\{([^}]+)\}/g, function(_, e) { return pyStr(evalExpr(e.trim(), vars)); });
  }
  if ((expr.startsWith('"') && expr.endsWith('"')) || (expr.startsWith("'") && expr.endsWith("'"))) {
    return expr.slice(1,-1).replace(/\\n/g,'\n').replace(/\\t/g,'\t');
  }
  if (expr === 'True') return true;
  if (expr === 'False') return false;
  if (expr === 'None') return null;
  if (!isNaN(expr) && expr !== '') return parseFloat(expr);
  if (expr.startsWith('[') && expr.endsWith(']')) {
    var inner = expr.slice(1,-1).trim();
    if (!inner) return [];
    return inner.split(',').map(function(x){ return evalExpr(x.trim(), vars); });
  }
  var lenM = expr.match(/^len\((.+)\)$/);
  if (lenM) { var v = evalExpr(lenM[1], vars); return Array.isArray(v) ? v.length : String(v).length; }
  var rangeM = expr.match(/^range\((\d+)(?:,\s*(\d+))?(?:,\s*(\d+))?\)$/);
  if (rangeM) {
    var start = rangeM[2] !== undefined ? parseInt(rangeM[1]) : 0;
    var stop  = rangeM[2] !== undefined ? parseInt(rangeM[2]) : parseInt(rangeM[1]);
    var step  = rangeM[3] !== undefined ? parseInt(rangeM[3]) : 1;
    var arr = []; for (var n = start; n < stop; n += step) arr.push(n); return arr;
  }
  var typeM = expr.match(/^type\((.+)\)$/);
  if (typeM) {
    var tv = evalExpr(typeM[1], vars);
    var tn = Array.isArray(tv)?'list':typeof tv==='boolean'?'bool':typeof tv==='number'?(Number.isInteger(tv)?'int':'float'):typeof tv==='string'?'str':'NoneType';
    return "<class '" + tn + "'>";
  }
  var castM = expr.match(/^(str|int|float|bool)\((.+)\)$/);
  if (castM) {
    var cv = evalExpr(castM[2], vars);
    if (castM[1]==='str') return String(cv);
    if (castM[1]==='int') return Math.trunc(parseFloat(String(cv)));
    if (castM[1]==='float') return parseFloat(String(cv));
    if (castM[1]==='bool') return !!cv;
  }
  var aggM = expr.match(/^(max|min|sum|sorted)\((.+)\)$/);
  if (aggM) {
    var av = evalExpr(aggM[2], vars);
    if (!Array.isArray(av)) av = (vars && vars[aggM[2]]) || [];
    if (aggM[1]==='max') return Math.max.apply(null, av);
    if (aggM[1]==='min') return Math.min.apply(null, av);
    if (aggM[1]==='sum') return av.reduce(function(a,b){return a+b;},0);
    if (aggM[1]==='sorted') return av.slice().sort(function(a,b){return a-b;});
  }
  // list indexing: fruits[0]
  var idxM = expr.match(/^([a-zA-Z_]\w*)\[(-?\d+)\]$/);
  if (idxM) {
    var arr = vars && vars[idxM[1]] ? vars[idxM[1]] : [];
    var idx = parseInt(idxM[2]);
    if (idx < 0) idx = arr.length + idx;
    return Array.isArray(arr) ? arr[idx] : undefined;
  }
  if (/^[a-zA-Z_][a-zA-Z0-9_]*$/.test(expr)) {
    if (vars && vars.hasOwnProperty(expr)) return vars[expr];
    return '(undefined: ' + expr + ')';
  }
  var safeExpr = expr.replace(/\b([a-zA-Z_][a-zA-Z0-9_]*)\b/g, function(m) {
    if (vars && vars.hasOwnProperty(m)) {
      var v = vars[m];
      return typeof v === 'string' ? JSON.stringify(v) : pyStr(v);
    }
    if (m === 'True') return 'true';
    if (m === 'False') return 'false';
    if (m === 'None') return 'null';
    return m;
  });
  try { return Function('"use strict";return (' + safeExpr + ')')(); } catch(e) { return expr; }
}

function pySimulate(code) {
  var output = [];
  var vars = {};

  function getBlock(lines, startIdx, baseIndent) {
    var block = [];
    var i = startIdx;
    while (i < lines.length) {
      var line = lines[i];
      if (line.trim() === '' || line.trim().startsWith('#')) { block.push(line); i++; continue; }
      var indent = line.match(/^(\s*)/)[1].length;
      if (indent > baseIndent) { block.push(line); i++; }
      else break;
    }
    return { block: block, nextIdx: i };
  }

  function execLines(lines, localVars) {
    var v = localVars || vars;
    var i = 0;
    while (i < lines.length) {
      var line = lines[i];
      var stripped = line.trimStart();
      if (!stripped || stripped.startsWith('#')) { i++; continue; }
      var baseIndent = line.match(/^(\s*)/)[1].length;

      // print()
      if (stripped.startsWith('print(')) {
        var inner = stripped.slice(6);
        if (inner.endsWith(')')) inner = inner.slice(0,-1);
        var parts = splitArgs(inner);
        var result = parts.map(function(p){ return pyStr(evalExpr(p.trim(), v)); }).join(' ');
        output.push(result);
        i++; continue;
      }

      // for loop
      var forM = stripped.match(/^for\s+(\w+)\s+in\s+(.+):$/);
      if (forM) {
        var iterVal = evalExpr(forM[2], v);
        var res = getBlock(lines, i+1, baseIndent);
        if (Array.isArray(iterVal)) {
          for (var fi = 0; fi < iterVal.length; fi++) {
            v[forM[1]] = iterVal[fi];
            execLines(res.block, v);
          }
        }
        i = res.nextIdx; continue;
      }

      // if statement
      var ifM = stripped.match(/^if\s+(.+):$/);
      if (ifM) {
        var cond = evalExpr(ifM[1], v);
        var res = getBlock(lines, i+1, baseIndent);
        if (cond && cond !== 0 && cond !== '' && cond !== null && cond !== false) {
          execLines(res.block, v);
        }
        i = res.nextIdx;
        // skip elif/else blocks
        while (i < lines.length) {
          var nline = lines[i].trimStart();
          var nindent = lines[i].match(/^(\s*)/)[1].length;
          if (nindent === baseIndent && (nline.startsWith('elif ') || nline.startsWith('else:'))) {
            var skip = getBlock(lines, i+1, baseIndent);
            i = skip.nextIdx;
          } else break;
        }
        continue;
      }

      // while loop
      var whileM = stripped.match(/^while\s+(.+):$/);
      if (whileM) {
        var res = getBlock(lines, i+1, baseIndent);
        var limit = 0;
        while (evalExpr(whileM[1], v) && limit < 100) {
          execLines(res.block, v); limit++;
        }
        i = res.nextIdx; continue;
      }

      // def (skip body)
      if (stripped.startsWith('def ')) {
        var res = getBlock(lines, i+1, baseIndent);
        i = res.nextIdx; continue;
      }

      // class (skip body)
      if (stripped.startsWith('class ')) {
        var res = getBlock(lines, i+1, baseIndent);
        i = res.nextIdx; continue;
      }

      // augmented assignment
      var augM = stripped.match(/^([a-zA-Z_]\w*)\s*(\+|-|\*|\/|\/\/)=\s*(.+)$/);
      if (augM) {
        var cur = v[augM[1]] !== undefined ? v[augM[1]] : 0;
        var val = evalExpr(augM[3], v);
        if (augM[2]==='+') v[augM[1]] = cur + val;
        else if (augM[2]==='-') v[augM[1]] = cur - val;
        else if (augM[2]==='*') v[augM[1]] = cur * val;
        else if (augM[2]==='/') v[augM[1]] = cur / val;
        else if (augM[2]==='//') v[augM[1]] = Math.floor(cur / val);
        i++; continue;
      }

      // assignment
      var assignM = stripped.match(/^([a-zA-Z_]\w*)\s*=\s*(.+)$/);
      if (assignM) {
        v[assignM[1]] = evalExpr(assignM[2], v);
        i++; continue;
      }

      i++;
    }
  }

  function splitArgs(s) {
    var parts = [], cur = '', depth = 0;
    for (var i = 0; i < s.length; i++) {
      var c = s[i];
      if ((c === '"' || c === "'")) {
        var q = c; cur += c; i++;
        while (i < s.length && s[i] !== q) { cur += s[i]; i++; }
        if (i < s.length) cur += s[i];
        continue;
      }
      if (c === '(' || c === '[') depth++;
      if (c === ')' || c === ']') depth--;
      if (c === ',' && depth === 0) { parts.push(cur.trim()); cur = ''; }
      else cur += c;
    }
    if (cur.trim()) parts.push(cur.trim());
    return parts;
  }

  try {
    execLines(code.split('\n'), vars);
  } catch(e) {
    return 'Error: ' + (e.toString ? e.toString() : String(e));
  }
  return output.length ? output.join('\n') : '(no output — try adding print() statements)';
}

