function renderDebug() {
  var wrap = document.getElementById('debugWrap');
  if (!wrap) return;
  wrap.innerHTML = DEBUG_CHALLENGES.map(function(ch, i){
    var diffColor = ch.diff==='Easy'?'var(--green)':ch.diff==='Medium'?'var(--accent3)':'var(--red)';
    return '<div class="debug-card">'
      +'<div class="debug-header">'
      +'<div><div class="debug-label">🐛 Bug Hunt #'+(i+1)+'</div><div class="debug-title">'+ch.title+'</div></div>'
      +'<div style="display:flex;align-items:center;gap:8px;">'
      +'<span class="debug-diff" style="background:'+diffColor+'22;color:'+diffColor+';border:1px solid '+diffColor+'44;">'+ch.diff+'</span>'
      +'<span class="xp-tag">+'+ch.xp+' XP</span></div></div>'
      +'<div class="debug-body">'
      +'<div class="debug-desc">'+ch.desc+'</div>'
      +'<div class="code-block"><div class="code-header"><span class="code-lang">🐛 buggy python</span>'
      +'<button class="copy-btn" onclick="copyDebugToPlayground('+i+')">▶ Try in Playground</button></div>'
      +'<pre>'+ch.code.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</pre></div>'
      +'<div style="display:flex;gap:9px;margin-top:12px;flex-wrap:wrap;">'
      +'<button class="debug-hint-btn" onclick="showDebugHint('+i+')">💡 Show Hint</button>'
      +'<button class="run-btn" onclick="revealDebugFix('+i+')">🔧 Reveal Fix</button></div>'
      +'<div class="debug-hint" id="dh-'+i+'">💡 Hint: '+ch.hint+'</div>'
      +'<div class="debug-result" id="df-'+i+'"></div>'
      +'</div></div>';
  }).join('');
}
function showDebugHint(i) {
  var el = document.getElementById('dh-'+i);
  if (el) el.classList.add('show');
}
function revealDebugFix(i) {
  var ch = DEBUG_CHALLENGES[i];
  var el = document.getElementById('df-'+i);
  if (!el) return;
  el.style.borderColor = 'rgba(16,185,129,.4)';
  el.style.color = '#a5d6ff';
  el.innerHTML = '✅ Fixed code:<br><br>' + ch.fix.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
  el.classList.add('show');
  addXP(ch.xp, 'Debug challenge solved!');
  save('debugSolved', true);
  checkAchievements();
  showToast('🔧 Bug fixed! +'+ch.xp+' XP');
}
function copyDebugToPlayground(i) {
  var ch = DEBUG_CHALLENGES[i];
  var editor = document.getElementById('pyEditor');
  if (editor) {
    editor.value = ch.code;
    document.getElementById('playground').scrollIntoView({behavior:'smooth'});
    showToast('🐛 Buggy code loaded — try fixing it!');
  }
}

