var unlockedAch = load('achievements', []);
function checkAchievements() {
  var newOnes = [];
  ACHIEVEMENTS.forEach(function(a) {
    if (unlockedAch.indexOf(a.id) === -1 && a.check()) {
      unlockedAch.push(a.id);
      newOnes.push(a);
    }
  });
  if (newOnes.length) {
    save('achievements', unlockedAch);
    newOnes.forEach(function(a) {
      setTimeout(function() {
        showToast('🏅 Achievement unlocked: ' + a.name + (a.xp?' (+'+a.xp+' XP)':''));
        if (a.xp) addXP(a.xp, 'Achievement: '+a.name);
        addWallItem(profile.avatar+' '+profile.name+' unlocked the "'+a.name+'" achievement!');
      }, 600);
    });
    renderAchievements();
  }
}
function renderAchievements() {
  var grid = document.getElementById('achGrid');
  if (!grid) return;
  grid.innerHTML = ACHIEVEMENTS.map(function(a) {
    var unlocked = unlockedAch.indexOf(a.id) > -1;
    return '<div class="ach-card '+(unlocked?'unlocked':'locked')+'">'
      +(unlocked?'<div class="ach-badge">✓</div>':'')
      +'<span class="ach-icon">'+a.icon+'</span>'
      +'<div class="ach-name">'+a.name+'</div>'
      +'<div class="ach-desc">'+a.desc+'</div>'
      +(a.xp?'<div style="font-size:.68rem;color:var(--accent);margin-top:6px;font-weight:700;">+'+a.xp+' XP</div>':'')
      +'</div>';
  }).join('');
}

