// ── GLOSSARY DATA ──
var GLOSSARY = [
  {term:'Argument',def:'A value passed to a function when calling it.',ex:'greet("Armstrong")  # "Armstrong" is the argument'},
  {term:'Boolean',def:'A data type with only two values: True or False.',ex:'is_active = True\nprint(type(is_active))  # bool'},
  {term:'Break',def:'A keyword that immediately exits a loop.',ex:'for i in range(10):\n    if i == 5: break'},
  {term:'Class',def:'A blueprint for creating objects with shared attributes and methods.',ex:'class Dog:\n    def __init__(self, name):\n        self.name = name'},
  {term:'Comprehension',def:'A concise way to create lists, dicts or sets in a single line.',ex:'squares = [x**2 for x in range(5)]'},
  {term:'Continue',def:'Skips the rest of the current loop iteration and moves to the next.',ex:'for i in range(5):\n    if i == 2: continue\n    print(i)'},
  {term:'Decorator',def:'A function that wraps another function to add behaviour.',ex:'@my_decorator\ndef my_func(): pass'},
  {term:'Dictionary',def:'A collection of key-value pairs, defined with curly braces {}.',ex:'student = {"name": "Ayo", "age": 20}'},
  {term:'Exception',def:'An error that occurs during program execution.',ex:'try:\n    x = 1/0\nexcept ZeroDivisionError:\n    print("Cannot divide by zero")'},
  {term:'f-string',def:'A string literal that allows embedding expressions inside {}.',ex:'name = "Armstrong"\nprint(f"Hello, {name}!")'},
  {term:'Float',def:'A number with a decimal point.',ex:'price = 3.99\nprint(type(price))  # float'},
  {term:'For Loop',def:'A loop that iterates over a sequence (list, range, string, etc.).',ex:'for fruit in ["mango","guava"]:\n    print(fruit)'},
  {term:'Function',def:'A reusable block of code defined with the def keyword.',ex:'def add(a, b):\n    return a + b'},
  {term:'Generator',def:'A function that yields values one at a time, saving memory.',ex:'def count_up(n):\n    for i in range(n): yield i'},
  {term:'Global',def:'A variable defined outside all functions, accessible everywhere.',ex:'x = 10  # global\ndef show(): print(x)'},
  {term:'If Statement',def:'Runs code only when a condition is True.',ex:'if score >= 90:\n    print("Grade A")'},
  {term:'Import',def:'Loads a module or specific items from a module into your script.',ex:'import math\nfrom os import path'},
  {term:'Index',def:'The position of an item in a sequence, starting from 0.',ex:'fruits = ["mango","apple"]\nprint(fruits[0])  # mango'},
  {term:'Inheritance',def:'When a child class takes attributes and methods from a parent class.',ex:'class Dog(Animal):\n    pass'},
  {term:'Integer',def:'A whole number without a decimal point.',ex:'age = 25\nprint(type(age))  # int'},
  {term:'Iterable',def:'Any object you can loop over (lists, strings, tuples, dicts, etc.).',ex:'for ch in "Python": print(ch)'},
  {term:'Lambda',def:'A small anonymous function defined in one line.',ex:'double = lambda x: x * 2\nprint(double(5))  # 10'},
  {term:'List',def:'An ordered, mutable sequence of items defined with square brackets [].',ex:'fruits = ["mango", "banana", "guava"]'},
  {term:'Local Variable',def:'A variable defined inside a function — only accessible there.',ex:'def greet():\n    msg = "Hi!"  # local\n    print(msg)'},
  {term:'Method',def:'A function that belongs to a class or object.',ex:'text = "hello"\nprint(text.upper())  # METHOD'},
  {term:'Module',def:'A Python file containing reusable code (functions, classes, variables).',ex:'import math\nprint(math.pi)'},
  {term:'None',def:'Python\'s null value — represents the absence of a value.',ex:'result = None\nprint(result is None)  # True'},
  {term:'Object',def:'An instance of a class.',ex:'dog = Dog("Rex")  # dog is an object'},
  {term:'Parameter',def:'A variable in a function definition that receives an argument.',ex:'def greet(name):  # name is the parameter\n    print(name)'},
  {term:'Pass',def:'A placeholder statement that does nothing — used where code is required.',ex:'class Empty:\n    pass'},
  {term:'Range',def:'A built-in function that generates a sequence of numbers.',ex:'for i in range(1, 6): print(i)  # 1 to 5'},
  {term:'Recursion',def:'When a function calls itself to solve a smaller version of a problem.',ex:'def factorial(n):\n    if n<=1: return 1\n    return n * factorial(n-1)'},
  {term:'Return',def:'Sends a value back from a function to the caller.',ex:'def add(a, b):\n    return a + b\nresult = add(3, 4)'},
  {term:'Scope',def:'The region of code where a variable is accessible.',ex:'x = 10  # global scope\ndef f():\n    y = 5  # local scope'},
  {term:'Self',def:'A reference to the current object in a class method.',ex:'class Cat:\n    def meow(self):\n        print(f"{self.name} says meow")'},
  {term:'Set',def:'An unordered collection of unique items defined with {}.',ex:'colors = {"red","blue","green"}\nprint(len(colors))  # 3'},
  {term:'Slice',def:'Extracts a portion of a list or string using [start:stop:step].',ex:'nums = [0,1,2,3,4]\nprint(nums[1:4])  # [1,2,3]'},
  {term:'String',def:'A sequence of characters enclosed in quotes.',ex:'name = "Armstrong"\nprint(name[0])  # A'},
  {term:'Tuple',def:'An ordered, immutable sequence defined with parentheses ().',ex:'coords = (10, 20)\nprint(coords[0])  # 10'},
  {term:'Type Hint',def:'An annotation that suggests what type a variable or function expects.',ex:'def greet(name: str) -> None:\n    print(name)'},
  {term:'Variable',def:'A named container that stores a value.',ex:'age = 25\ncity = "Thika"'},
  {term:'While Loop',def:'A loop that keeps running as long as a condition is True.',ex:'count = 0\nwhile count < 5:\n    count += 1'},
  {term:'With Statement',def:'Manages resources (like files) automatically, ensuring cleanup.',ex:'with open("file.txt") as f:\n    data = f.read()'},
  {term:'Yield',def:'Pauses a generator function and returns a value to the caller.',ex:'def gen():\n    yield 1\n    yield 2'}
];

function renderGlossary(filtered) {
  var list = filtered || GLOSSARY;
  var letters = [...new Set(list.map(function(g){ return g.term[0].toUpperCase(); }))].sort();
  document.getElementById('glossaryLetters').innerHTML =
    '<button class="gl-letter active" onclick="filterGlossaryLetter(null,this)">All</button>' +
    letters.map(function(l){ return '<button class="gl-letter" onclick="filterGlossaryLetter(\''+l+'\',this)">'+l+'</button>'; }).join('');
  document.getElementById('glossaryList').innerHTML = list.map(function(g){
    return '<div class="glossary-item">'
      +'<div class="gl-term">'+g.term+'</div>'
      +'<div class="gl-def">'+g.def+'</div>'
      +(g.ex?'<div class="gl-example">'+g.ex.replace(/\n/g,'<br>')+'</div>':'')
      +'</div>';
  }).join('') || '<div style="color:var(--muted);font-size:.85rem;">No terms found.</div>';
}
function filterGlossary(q) {
  var searches = load('glossarySearches',0) + 1;
  save('glossarySearches', searches);
  var filtered = GLOSSARY.filter(function(g){
    return g.term.toLowerCase().includes(q.toLowerCase()) || g.def.toLowerCase().includes(q.toLowerCase());
  });
  renderGlossary(filtered);
}
function filterGlossaryLetter(letter, btn) {
  document.querySelectorAll('.gl-letter').forEach(function(b){ b.classList.remove('active'); });
  btn.classList.add('active');
  document.getElementById('glossarySearch').value = '';
  if (!letter) { renderGlossary(); return; }
  renderGlossary(GLOSSARY.filter(function(g){ return g.term[0].toUpperCase() === letter; }));
}

// ── COMMON ERRORS ──
var COMMON_ERRORS = [
  {name:'SyntaxError',cause:'Your code has invalid Python syntax — often a missing colon, bracket, or quote.',fix:'✅ Check for missing : after if/for/def, unclosed brackets (), [], {}, or mismatched quotes.',example:'if x > 5  # Missing colon!\n    print(x)'},
  {name:'NameError',cause:'You used a variable or function that hasn\'t been defined yet.',fix:'✅ Make sure you spell the variable name correctly and define it before using it.',example:'print(age)  # NameError: age not defined\nage = 25    # Define BEFORE using'},
  {name:'TypeError',cause:'An operation was applied to the wrong data type (e.g., adding a string to an int).',fix:'✅ Use type() to check types. Convert with int(), str(), float() when needed.',example:'print("Age: " + 25)  # TypeError!\nprint("Age: " + str(25))  # Fixed'},
  {name:'IndexError',cause:'You tried to access an index that doesn\'t exist in a list or string.',fix:'✅ Remember indexing starts at 0. Use len() to check the valid range.',example:'fruits = ["mango","banana"]\nprint(fruits[5])  # IndexError!\nprint(fruits[1])  # Fixed: "banana"'},
  {name:'KeyError',cause:'You tried to access a dictionary key that doesn\'t exist.',fix:'✅ Use .get(key, default) to safely access dict values without crashing.',example:'d = {"name": "Ayo"}\nprint(d["age"])  # KeyError!\nprint(d.get("age", "N/A"))  # Fixed'},
  {name:'AttributeError',cause:'You called a method or attribute that doesn\'t exist on that object.',fix:'✅ Check the documentation for the correct method name. Use dir(obj) to list available methods.',example:'num = 42\nnum.upper()  # AttributeError! ints have no upper()\n"hello".upper()  # Works — string method'},
  {name:'ValueError',cause:'A function received an argument of the correct type but invalid value.',fix:'✅ Validate user input before converting. Use try/except to handle bad values gracefully.',example:'int("hello")  # ValueError! Can\'t convert\nint("42")     # Works'},
  {name:'IndentationError',cause:'Your code block isn\'t indented correctly — Python uses 4 spaces.',fix:'✅ Use 4 spaces consistently. Avoid mixing tabs and spaces.',example:'def greet():\nprint("Hi")  # IndentationError!\ndef greet():\n    print("Hi")  # Fixed'},
  {name:'ZeroDivisionError',cause:'Your code tried to divide a number by zero.',fix:'✅ Always check if the divisor is 0 before dividing, or use try/except.',example:'result = 10 / 0  # ZeroDivisionError!\nif b != 0:\n    result = 10 / b  # Safe'},
  {name:'ImportError',cause:'Python can\'t find the module you\'re trying to import.',fix:'✅ Install missing packages with pip install package_name. Check spelling of the module name.',example:'import numppy  # ImportError! Wrong spelling\nimport numpy   # Correct'},
  {name:'RecursionError',cause:'A recursive function called itself too many times without stopping.',fix:'✅ Make sure your recursive function has a clear base case that stops the recursion.',example:'def loop(): loop()  # Infinite recursion!\ndef factorial(n):\n    if n<=1: return 1  # Base case'},
  {name:'FileNotFoundError',cause:'You tried to open a file that doesn\'t exist at the given path.',fix:'✅ Check the file path and name carefully. Use os.path.exists() to verify before opening.',example:'open("myfile.txt")  # FileNotFoundError\nimport os\nif os.path.exists("myfile.txt"):\n    open("myfile.txt")'}
];
