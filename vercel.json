// ── SEARCH ──
var searchIdx=[];
function buildSearch(){
  lessons.forEach(function(l){
    searchIdx.push({t:l.title,d:l.desc,cat:'Lesson',fn:function(){openLesson(l.id);}});
    l.pts.forEach(function(p){searchIdx.push({t:p,d:'Lesson: '+l.title,cat:'Topic',fn:function(){openLesson(l.id);}});});
  });
  noteBlocks.forEach(function(n){
    searchIdx.push({t:n.title+' Notes',d:n.intro.substring(0,70)+'...',cat:'Notes',fn:function(){switchNote(n.id);document.getElementById('notes').scrollIntoView({behavior:'smooth'});}});
  });
  Object.keys(quizData).forEach(function(topic){
    searchIdx.push({t:topic+' Quiz',d:quizData[topic].length+' questions',cat:'Quiz',fn:function(){document.getElementById('quiz').scrollIntoView({behavior:'smooth'});}});
  });
}
function toggleSearch(){
  document.getElementById('searchOverlay').classList.toggle('open');
  setTimeout(function(){document.getElementById('searchInput').focus();},100);
}
function closeSearchBg(e){
  if(e.target===document.getElementById('searchOverlay')){
    document.getElementById('searchOverlay').classList.remove('open');
    document.getElementById('searchInput').value='';
    document.getElementById('searchResults').innerHTML='';
  }
}
function doSearch(q){
  var res=document.getElementById('searchResults');
  if(!q){res.innerHTML='';return;}
  var matches=searchIdx.filter(function(s){
    return s.t.toLowerCase().indexOf(q.toLowerCase())>-1||s.d.toLowerCase().indexOf(q.toLowerCase())>-1;
  }).slice(0,8);
  if(!matches.length){res.innerHTML='<div style="padding:10px;color:var(--muted);font-size:.83rem;">No results found.</div>';return;}
  res.innerHTML=matches.map(function(m,i){
    return '<div class="s-result" onclick="searchGo('+i+')"><strong>'+m.cat+'</strong> · '+m.t+'<span>'+m.d+'</span></div>';
  }).join('');
  window._sMatches=matches;
}
function searchGo(i){
  window._sMatches[i].fn();
  document.getElementById('searchOverlay').classList.remove('open');
  document.getElementById('searchInput').value='';
}
document.addEventListener('keydown',function(e){if(e.key==='Escape') document.getElementById('searchOverlay').classList.remove('open');});

// ── STREAK ──
function checkStreak(){
  var today=new Date().toDateString();
  if(lastVisit===today) return;
  var yesterday=new Date(Date.now()-86400000).toDateString();
  if(lastVisit===yesterday) streak++;
  else streak=1;
  save('streak',streak); save('lastVisit',today); lastVisit=today;
  if(streak>1){
    document.getElementById('streakMsg').textContent=streak+' Day Streak!';
    var sp=document.getElementById('streakPopup');
    sp.classList.add('show');
    setTimeout(function(){sp.classList.remove('show');},4000);
  }
  addXP(5,'Daily visit');
}

// ── PROGRESS ──
function updateProgress(){
  var pct=Math.round((completed.length/lessons.length)*100);
  document.getElementById('progText').textContent=completed.length+'/'+lessons.length+' lessons';
  document.getElementById('progFill').style.width=pct+'%';
  var badges=[];
  if(completed.length>=1) badges.push('🌱 Started');
  if(completed.length>=5) badges.push('📚 25%');
  if(completed.length>=10) badges.push('⚡ Halfway');
  if(completed.length>=15) badges.push('🔥 75%!');
  if(completed.length>=20) badges.push('🏆 All Done!');
  document.getElementById('progBadges').innerHTML=badges.map(function(b){return '<span class="prog-badge">'+b+'</span>';}).join('');
  document.getElementById('certBtn').style.display=completed.length>=20?'inline-block':'none';
}

// ── LESSONS ──
function renderLessons(){
  var grid=document.getElementById('lessonsGrid');
  var qs=document.getElementById('qaLesson');
  var rs=document.getElementById('revLesson');
  grid.innerHTML=lessons.map(function(l,i){
    var done=completed.indexOf(l.id)>-1;
    var bk=bookmarks.indexOf(l.id)>-1;
    return '<div class="lesson-card fade-up'+(done?' completed':'')+(bk?' bookmarked':'')+'" style="animation-delay:'+(i*0.06)+'s" id="lc-'+l.id+'">'
      +'<div class="lesson-thumb" onclick="openLesson('+l.id+')">'
      +'<iframe src="https://www.youtube-nocookie.com/embed/'+l.vid+'?mute=1" loading="lazy" allowfullscreen></iframe>'
      +'<div class="play-overlay"><div class="play-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="#0a0e1a"><polygon points="5,3 19,12 5,21"/></svg></div></div>'
      +'</div>'
      +'<div class="lesson-body">'
      +'<div class="lesson-num">Lesson '+String(l.id).padStart(2,'0')+'</div>'
      +'<div class="lesson-title">'+l.title+'</div>'
      +'<div class="lesson-desc">'+l.desc+'</div>'
      +'<div class="lesson-meta"><span class="tag '+l.lc+'">'+l.level+'</span><span class="duration">⏱ '+l.dur+'</span></div>'
      +'<div class="card-actions">'
      +'<button class="card-btn'+(done?' done-active':'')+'" onclick="toggleDone('+l.id+')">'+(done?'✓ Done':'Mark Done')+'</button>'
      +'<button class="card-btn'+(bk?' bk-active':'')+'" onclick="toggleBookmark('+l.id+')">'+(bk?'🔖 Saved':'🔖 Save')+'</button>'
      +'<button class="card-btn" onclick="openLesson('+l.id+')">▶ Watch</button>'
      +'</div></div></div>';
  }).join('');
  // populate selects
  if(qs.options.length<=1){
    lessons.forEach(function(l){
      var o1=document.createElement('option');o1.value=l.title;o1.textContent=l.title;qs.appendChild(o1);
      var o2=document.createElement('option');o2.value=l.title;o2.textContent=l.title;rs.appendChild(o2);
    });
  }
}

function toggleDone(id){
  var was=completed.indexOf(id)>-1;
  if(was) completed=completed.filter(function(x){return x!==id;});
  else completed.push(id);
  save('completed',completed);
  renderLessons(); updateProgress();
  if(!was){
    addXP(25,'Lesson completed!');
    if(completed.length===lessons.length){
      setTimeout(function(){
        launchConfetti();
        addXP(200,'ALL lessons completed!');
        showToast('🏆 Congratulations! You finished all lessons!');
      },400);
    }
  }
  showToast(completed.indexOf(id)>-1?'✅ Marked as done!':'↩️ Unmarked');
}
function toggleBookmark(id){
  if(bookmarks.indexOf(id)>-1) bookmarks=bookmarks.filter(function(x){return x!==id;});
  else bookmarks.push(id);
  save('bookmarks',bookmarks); renderLessons();
  showToast(bookmarks.indexOf(id)>-1?'🔖 Bookmarked!':'Bookmark removed');
}
function filterLessons(filter,btn){
  document.querySelectorAll('.filter-btn').forEach(function(b){b.classList.remove('active');});
  btn.classList.add('active');
  document.querySelectorAll('.lesson-card').forEach(function(card){
    var id=parseInt(card.id.replace('lc-',''));
    var lesson=lessons.find(function(l){return l.id===id;});
    var show=true;
    if(filter==='bookmarked') show=bookmarks.indexOf(id)>-1;
    else if(filter==='completed') show=completed.indexOf(id)>-1;
    else if(filter!=='all') show=lesson&&lesson.level===filter;
    card.style.display=show?'':'none';
  });
}

// ── PLAYER ──
function openLesson(id){
  currentLesson=lessons.find(function(l){return l.id===id;});
  var ps=document.getElementById('player-section');
  ps.classList.add('visible');
  document.getElementById('mainVideo').src='https://www.youtube-nocookie.com/embed/'+currentLesson.vid+'?autoplay=1';
  document.getElementById('videoInfo').innerHTML=
    '<div class="video-title">'+currentLesson.title+'</div>'
    +'<div class="video-meta">Lesson '+String(currentLesson.id).padStart(2,'0')+' · '+currentLesson.dur+' · '+currentLesson.level+'</div>'
    +'<div class="video-desc">'+currentLesson.desc+'</div>'
    +'<div class="kp-title">Key Points</div>'
    +currentLesson.pts.map(function(p){return '<div class="kp-item">'+p+'</div>';}).join('')
    +'<button class="next-btn" onclick="nextLesson()">Next Lesson →</button>';
  document.getElementById('sidebarLessons').innerHTML=lessons.map(function(l){
    var active=l.id===id;
    return '<div onclick="openLesson('+l.id+')" style="padding:9px;border-radius:7px;cursor:pointer;margin-bottom:2px;background:'+(active?'rgba(0,229,255,.08)':'transparent')+';border-left:3px solid '+(active?'var(--accent)':'transparent')+';transition:all .2s;">'
      +'<div style="font-size:.62rem;color:var(--muted);font-family:Space Mono,monospace;">L'+String(l.id).padStart(2,'0')+'</div>'
      +'<div style="font-size:.8rem;font-weight:'+(active?700:400)+';color:'+(active?'var(--accent)':'var(--text)')+';">'+l.title+'</div>'
      +'</div>';
  }).join('');
  ps.scrollIntoView({behavior:'smooth'});
}
function nextLesson(){
  if(!currentLesson) return;
  var next=lessons.find(function(l){return l.id===currentLesson.id+1;});
  if(next) openLesson(next.id); else showToast('🎉 You finished all lessons!');
}

// ── NOTES ──
function renderNotes(){
  document.getElementById('notesTabs').innerHTML=noteBlocks.map(function(n,i){
    return '<div class="note-tab'+(i===0?' active':'')+'" onclick="switchNote('+n.id+')" id="ntab-'+n.id+'">'
      +n.icon+' '+n.title
      +'<span class="note-tab-num">L'+String(n.id).padStart(2,'0')+'</span></div>';
  }).join('');
  document.getElementById('notesPanel').innerHTML=noteBlocks.map(function(n,i){
    return '<div class="notes-content'+(i===0?' active':'')+'" id="nc-'+n.id+'">'
      +'<span class="note-lvl-badge '+n.level+'">'+n.level+'</span>'
      +'<div class="note-title">'+n.icon+' '+n.title+'</div>'
      +'<div class="note-intro">'+n.intro+'</div>'
      +'<button class="dl-btn" onclick="downloadNote('+n.id+')">📥 Download Notes</button>'
      +n.blocks.map(function(b){
        var html='<div class="note-block">'
          +'<div class="note-block-title">'+b.t+'</div>';
        if(b.e) html+='<div class="note-expl">'+b.e+'</div>';
        if(b.tbl){
          html+='<table class="note-table"><thead><tr>'+b.tbl.h.map(function(h){return '<th>'+h+'</th>';}).join('')+'</tr></thead><tbody>'
            +b.tbl.r.map(function(r){return '<tr>'+r.map(function(c){return '<td>'+c+'</td>';}).join('')+'</tr>';}).join('')
            +'</tbody></table>';
        }
        if(b.c){
          html+='<div class="code-block"><div class="code-header"><span class="code-lang">python</span>'
            +'<button class="copy-btn" onclick="copyCode(this)">📋 Copy</button></div>'
            +'<pre>'+b.c.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</pre></div>';
        }
        if(b.tip){
          html+='<div class="tip-box '+b.tip.cls+'"><span class="tip-icon">'+b.tip.ic+'</span>'
            +'<div class="tip-text">'+b.tip.tx+'</div></div>';
        }
        html+='</div>';
        return html;
      }).join('')
      +'<div class="notes-nav">'
      +(i>0?'<button class="btn btn-outline" onclick="switchNote('+noteBlocks[i-1].id+')">← Previous</button>':'')
      +(i<noteBlocks.length-1?'<button class="btn btn-primary" onclick="switchNote('+noteBlocks[i+1].id+')">Next →</button>':'')
      +'</div></div>';
  }).join('');
}
function switchNote(id){
  document.querySelectorAll('.note-tab').forEach(function(t){t.classList.remove('active');});
  document.querySelectorAll('.notes-content').forEach(function(c){c.classList.remove('active');});
  var tab=document.getElementById('ntab-'+id);
  var content=document.getElementById('nc-'+id);
  if(tab) tab.classList.add('active');
