  ctx.strokeStyle='rgba(0,229,255,.25)'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(80,128); ctx.lineTo(W-80,128); ctx.stroke();
  ctx.fillStyle='#64748b'; ctx.font='15px sans-serif'; ctx.fillText('This certifies that',W/2,168);
