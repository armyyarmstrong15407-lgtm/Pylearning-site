  var lines=["ARMSTRONG'S PYTHON KNOWLEDGE — "+n.title.toUpperCase()+" NOTES","=".repeat(56),"Level: "+n.level,"",n.intro,""];
  n.blocks.forEach(function(b){
    lines.push("-".repeat(40),b.t,"-".repeat(40));
    if(b.e) lines.push(b.e.replace(/<[^>]+>/g,''));
    if(b.tbl){lines.push(b.tbl.h.join(' | '));b.tbl.r.forEach(function(r){lines.push(r.join(' | '));});}
    if(b.c) lines.push("\n[CODE]\n"+b.c);
    if(b.tip) lines.push("\nTIP: "+b.tip.tx.replace(/<[^>]+>/g,''));
    lines.push('');
  });
  lines.push("=".repeat(56),"Armstrong's Studios · Thika, Kenya");
  var blob=new Blob([lines.join('\n')],{type:'text/plain'});
  var a=document.createElement('a');a.href=URL.createObjectURL(blob);
