// ── HEATMAP ──
var activityData = load('activity', {});
function recordActivity() {
  var today = new Date().toISOString().split('T')[0];
  activityData[today] = (activityData[today] || 0) + 1;
  save('activity', activityData);
  renderHeatmap();
}
function renderHeatmap() {
  var grid = document.getElementById('hmGrid');
  var months = document.getElementById('hmMonths');
  if (!grid) return;
  var now = new Date();
  var cells = [];
  var cols = 53;
  var monthLabels = [];
  var lastMonth = -1;
  for (var w = cols-1; w >= 0; w--) {
    var col = [];
    for (var d = 0; d < 7; d++) {
      var daysAgo = (cols-1-w)*7 + (6-d);
      var dt = new Date(now);
      dt.setDate(dt.getDate() - daysAgo);
      var key = dt.toISOString().split('T')[0];
      var count = activityData[key] || 0;
      var lvl = count===0?0:count===1?1:count<=3?2:count<=5?3:4;
      var dateStr = dt.toDateString();
      col.push('<div class="hm-cell hm-'+lvl+'" title="'+dateStr+': '+count+' activities" onclick="showDayTip(this, \''+dateStr+'\', '+count+')"></div>');
      if (dt.getMonth() !== lastMonth && d === 0) {
        var mNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        monthLabels.push({idx:cols-1-w, name:mNames[dt.getMonth()]});
        lastMonth = dt.getMonth();
      }
    }
    cells.push('<div class="hm-col">'+col.join('')+'</div>');
  }
  grid.innerHTML = cells.join('');
  if (months) {
    var mHtml = '';
    var prevIdx = 0;
    monthLabels.forEach(function(m) {
      var gap = (m.idx - prevIdx) * 16;
      mHtml += '<span style="margin-left:'+gap+'px">'+m.name+'</span>';
      prevIdx = m.idx;
    });
    months.innerHTML = mHtml;
  }
}
function showDayTip(el, date, count) {
  showToast(date + ': ' + count + ' ' + (count===1?'activity':'activities'));
}

// ── STUDY TIMER ──
var timerRunning = false;
var timerSeconds = 0;
var timerInterval = null;
var todayStudyTime = load('todayStudy', 0);
function toggleTimer() {
  var btn = document.getElementById('timerStartBtn');
  if (!btn) return;
  if (timerRunning) {
    clearInterval(timerInterval);
    timerRunning = false;
    if(btn){btn.textContent='▶ Start';btn.classList.remove('active');}
    todayStudyTime += timerSeconds;
    save('todayStudy', todayStudyTime);
    recordActivity();
    updateTimerDisplay();
    if (timerSeconds >= 60) addXP(Math.floor(timerSeconds/60), 'Study time!');
  } else {
    timerRunning = true;
    if(btn){btn.textContent='⏸ Pause';btn.classList.add('active');}
    timerInterval = setInterval(function() {
      timerSeconds++;
      updateTimerDisplay();
    }, 1000);
  }
}
function resetTimer() {
  clearInterval(timerInterval);
  timerRunning = false;
  timerSeconds = 0;
  var b=document.getElementById('timerStartBtn');
  if(b){b.textContent='▶ Start';b.classList.remove('active');}
  updateTimerDisplay();
}
function updateTimerDisplay() {
  var m = Math.floor(timerSeconds/60);
  var s = timerSeconds%60;
  document.getElementById('timerDisplay').textContent = String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
  var totalMins = Math.floor((todayStudyTime + timerSeconds)/60);
  var todayEl = document.getElementById('todayTime');
  if (todayEl) todayEl.textContent = totalMins + 'm';
}
function renderWeeklyReport() {
  var xpEl = document.getElementById('wrXP');
  var lessonsEl = document.getElementById('wrLessons');
  var quizzesEl = document.getElementById('wrQuizzes');
  if (!xpEl) return;
  var weekXP = load('weekXP', 0);
  xpEl.textContent = weekXP;
  lessonsEl.textContent = completed.length;
  quizzesEl.textContent = quizHistory.length;
}

// ── LEARNER WALL ──
var wallItems = load('wall', [
  {avatar:'🦁',text:'Wanjiku completed Python Basics: Getting Started!',time:'2 days ago'},
  {avatar:'🤖',text:'Brian scored 5/5 on the OOP quiz!',time:'3 days ago'},
  {avatar:'🌍',text:'Amina unlocked the "Quiz Master" achievement!',time:'1 week ago'}
]);
function addWallItem(text) {
  wallItems.unshift({avatar:profile.avatar, text:text, time:'Just now'});
  wallItems = wallItems.slice(0, 20);
  save('wall', wallItems);
  renderWall();
}
function renderWall() {
  var feed = document.getElementById('wallFeed');
  if (!feed) return;
  feed.innerHTML = wallItems.map(function(item) {
    return '<div class="wall-item"><div class="wall-av">'+item.avatar+'</div>'
      +'<div><div class="wall-text">'+item.text+'</div><div class="wall-time">'+item.time+'</div></div></div>';
  }).join('');
}

// ── SHARE ──
var _shareData = {};
function openShare(title, text, url) {
  _shareData = {title:title, text:text, url:url||window.location.href};
  document.getElementById('sharePreview').textContent = text;
  document.getElementById('share-modal').classList.add('open');
}
function closeShare() { document.getElementById('share-modal').classList.remove('open'); }
function doShare(type) {
  var msg = _shareData.text + ' ' + _shareData.url;
  if (type === 'wa') window.open('https://wa.me/?text='+encodeURIComponent(msg), '_blank');
  else if (type === 'x') window.open('https://twitter.com/intent/tweet?text='+encodeURIComponent(msg), '_blank');
  else if (type === 'copy') { navigator.clipboard.writeText(msg); showToast('📋 Copied to clipboard!'); }
  closeShare();
}
document.getElementById('share-modal').addEventListener('click', function(e) { if (e.target===document.getElementById('share-modal')) closeShare(); });

// ── OVERRIDE SUBMIT REVIEW TO TRACK ──
var _origSubmitReview = submitReview;
submitReview = function() {
  var name = document.getElementById('revName');
  var hasName = name && name.value.trim();
  _origSubmitReview();
  save('hasReview', true);
  if (hasName) {
    addWallItem(profile.avatar + ' ' + profile.name + ' left a review!');
  }
  checkAchievements();
};

// ── UPDATE XP BAR (add weekly tracking) ──
var _origAddXP = addXP;
var _addingXP = false;
addXP = function(amount, reason) {
  _origAddXP(amount, reason);
  var weekXP = load('weekXP', 0) + amount;
  save('weekXP', weekXP);
  renderWeeklyReport();
  if (!_addingXP) {
    _addingXP = true;
    checkAchievements();
    _addingXP = false;
  }
};

// ── ADD SHARE BUTTONS TO LESSONS ──
var _origOpenLesson = openLesson;
openLesson = function(id) {
  _origOpenLesson(id);
  var lesson = lessons.find(function(l){return l.id===id;});
  if (!lesson) return;
  var info = document.getElementById('videoInfo');
  if (info) {
    var shareBtn = document.createElement('button');
    shareBtn.className = 'btn btn-outline btn-sm';
    shareBtn.style.marginTop = '8px';
    shareBtn.textContent = '📤 Share Lesson';
    shareBtn.onclick = function() {
      openShare(lesson.title, "I am learning \""+lesson.title+"\" on Armstrong's Python Knowledge! Check it out: ");
    };
    info.appendChild(shareBtn);
  }
};

// ── INIT NEW FEATURES ──
renderAchievements();
renderProjects();
renderCheatSheet();
renderHeatmap();
renderWeeklyReport();
renderWall();
renderGlossary();
renderErrors();
renderDebug();
recordActivity();
checkAchievements();

// Track login days
(function(){
  var today = new Date().toDateString();
  var days = load('loginDaysArr',[]);
  if (days.indexOf(today) === -1) {
    days.push(today);
    save('loginDaysArr', days);
    save('loginDays', days.length);
  }
})();


