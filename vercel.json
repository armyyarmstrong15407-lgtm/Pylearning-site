// ── LEVELS ──
var LEVELS=[
  {name:"Beginner",min:0,max:99},
  {name:"Learner",min:100,max:249},
  {name:"Coder",min:250,max:499},
  {name:"Developer",min:500,max:899},
  {name:"Pro",min:900,max:1499},
  {name:"Master",min:1500,max:9999}
];
function getLvl(x){
  for(var i=0;i<LEVELS.length;i++) if(x>=LEVELS[i].min&&x<=LEVELS[i].max) return {lvl:LEVELS[i],idx:i};
  return {lvl:LEVELS[LEVELS.length-1],idx:LEVELS.length-1};
}
function addXP(amount,reason){
  xp+=amount; save('xp',xp); updateXPBar();
  showToast('⚡ +'+amount+' XP — '+reason);
}
function updateXPBar(){
  var info=getLvl(xp);
  var next=LEVELS[info.idx+1];
  var pct=next?Math.round(((xp-info.lvl.min)/(next.min-info.lvl.min))*100):100;
  document.getElementById('xpFill').style.width=pct+'%';
  document.getElementById('xpPts').textContent=xp+(next?' / '+next.min:'')+' XP';
  document.getElementById('xpLvl').textContent='Level '+(info.idx+1)+' · '+info.lvl.name;
  document.getElementById('xpStreak').textContent='🔥 '+streak+' streak';
  document.getElementById('xpAvatar').textContent=profile.avatar;
  document.getElementById('xpName').textContent=profile.name;
}

