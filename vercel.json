<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Armstrong's Python Knowledge</title>
<meta name="description" content="Free Python education by Armstrong's Studios — lessons, notes, quizzes, playground and more.">
<meta name="keywords" content="Python, programming, learn Python, Armstrong, Kenya, coding tutorials">
<meta name="author" content="Armstrong's Studios">
<meta name="theme-color" content="#0a0e1a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="manifest" href="data:application/json,{&quot;name&quot;:&quot;Armstrong's Python Knowledge&quot;,&quot;short_name&quot;:&quot;PyKnowledge&quot;,&quot;start_url&quot;:&quot;.&quot;,&quot;display&quot;:&quot;standalone&quot;,&quot;background_color&quot;:&quot;%230a0e1a&quot;,&quot;theme_color&quot;:&quot;%2300e5ff&quot;,&quot;icons&quot;:[{&quot;src&quot;:&quot;data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐍</text></svg>&quot;,&quot;sizes&quot;:&quot;any&quot;,&quot;type&quot;:&quot;image/svg+xml&quot;}]}">
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Sora:wght@300;400;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/skulpt/1.2.0/skulpt.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/skulpt/1.2.0/skulpt-stdlib.js"></script>
<style>
:root{--bg:#0a0e1a;--surface:#111827;--surface2:#1a2235;--accent:#00e5ff;--accent2:#7c3aed;--accent3:#f59e0b;--text:#e2e8f0;--muted:#64748b;--green:#10b981;--red:#ef4444;--border:rgba(0,229,255,0.15);}
[data-theme=light]{--bg:#f0f4ff;--surface:#ffffff;--surface2:#e8edf8;--accent:#0077aa;--accent2:#6d28d9;--accent3:#d97706;--text:#0f172a;--muted:#475569;--green:#059669;--red:#dc2626;--border:rgba(0,119,170,0.2);}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:'Sora',sans-serif;min-height:100vh;overflow-x:hidden;transition:background .3s,color .3s;padding-bottom:60px;}
/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:12px 32px;background:rgba(10,14,26,0.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);gap:10px;}
[data-theme=light] nav{background:rgba(240,244,255,0.95);}
.logo{font-family:'Space Mono',monospace;font-size:.95rem;font-weight:700;color:var(--accent);white-space:nowrap;}
.logo span{color:var(--accent3);}
nav ul{display:flex;gap:3px;list-style:none;flex-wrap:wrap;}
nav ul li a{font-size:.68rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:var(--muted);text-decoration:none;padding:6px 10px;border-radius:6px;transition:all .2s;white-space:nowrap;}
nav ul li a:hover{color:var(--accent);background:rgba(0,229,255,.07);}
.nav-right{display:flex;align-items:center;gap:6px;flex-shrink:0;}
.icon-btn{width:34px;height:34px;border-radius:50%;border:1px solid var(--border);background:transparent;cursor:pointer;font-size:.95rem;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;}
.icon-btn:hover{border-color:var(--accent);}
.lang-toggle{display:flex;gap:2px;padding:3px;background:var(--surface2);border-radius:7px;border:1px solid var(--border);}
.lang-btn{padding:3px 9px;border-radius:5px;font-size:.68rem;font-weight:700;cursor:pointer;border:none;background:transparent;color:var(--muted);font-family:'Sora',sans-serif;transition:all .2s;}
.lang-btn.active{background:var(--accent2);color:#fff;}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:5px;border:none;background:transparent;}
.hamburger span{width:20px;height:2px;background:var(--text);border-radius:2px;transition:all .3s;display:block;}
.hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
.hamburger.open span:nth-child(2){opacity:0;}
.hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
.mobile-menu{display:none;position:fixed;top:58px;left:0;right:0;background:rgba(10,14,26,.98);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:14px 20px;z-index:199;flex-direction:column;gap:3px;}
.mobile-menu.open{display:flex;}
.mobile-menu a{font-size:.82rem;font-weight:600;color:var(--muted);text-decoration:none;padding:10px 14px;border-radius:8px;letter-spacing:1px;text-transform:uppercase;}
.mobile-menu a:hover{color:var(--accent);background:rgba(0,229,255,.07);}
/* SEARCH */
.search-overlay{display:none;position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.75);backdrop-filter:blur(8px);align-items:flex-start;justify-content:center;padding-top:100px;}
.search-overlay.open{display:flex;}
.search-box{background:var(--surface2);border:1px solid var(--accent);border-radius:16px;padding:22px;width:90%;max-width:580px;}
.search-input{width:100%;padding:13px 16px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-family:'Sora',sans-serif;font-size:.95rem;outline:none;margin-bottom:14px;}
.search-input:focus{border-color:var(--accent);}
.search-results{display:flex;flex-direction:column;gap:6px;max-height:280px;overflow-y:auto;}
.s-result{padding:11px 14px;border-radius:9px;background:var(--surface);border:1px solid var(--border);cursor:pointer;font-size:.85rem;transition:border-color .2s;}
.s-result:hover{border-color:var(--accent);color:var(--accent);}
.s-result span{color:var(--muted);font-size:.72rem;display:block;margin-top:2px;}
/* XP BAR */
.xp-bar-wrap{position:fixed;bottom:0;left:0;right:0;z-index:150;background:rgba(10,14,26,.94);backdrop-filter:blur(12px);border-top:1px solid var(--border);padding:7px 20px;display:flex;align-items:center;gap:14px;}
[data-theme=light] .xp-bar-wrap{background:rgba(240,244,255,.94);}
.xp-profile{display:flex;align-items:center;gap:8px;cursor:pointer;padding:4px 10px;border-radius:8px;border:1px solid transparent;transition:border-color .2s;flex-shrink:0;}
.xp-profile:hover{border-color:var(--border);}
.xp-avatar{font-size:1.3rem;}
.xp-name{font-size:.72rem;font-weight:700;white-space:nowrap;}
.xp-lvl{font-size:.62rem;color:var(--accent);}
.xp-bar-inner{flex:1;min-width:80px;height:5px;background:var(--surface2);border-radius:100px;overflow:hidden;}
.xp-bar-fill{height:100%;background:linear-gradient(90deg,var(--accent2),var(--accent));border-radius:100px;transition:width .6s ease;}
.xp-pts{font-family:'Space Mono',monospace;font-size:.68rem;color:var(--muted);white-space:nowrap;}
.xp-streak{font-size:.75rem;color:var(--accent3);font-weight:700;white-space:nowrap;}
/* HERO */
.hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120px 24px 80px;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 60% at 50% 30%,rgba(124,58,237,.18) 0%,transparent 70%),radial-gradient(ellipse 50% 40% at 80% 80%,rgba(0,229,255,.1) 0%,transparent 60%);pointer-events:none;}
.hero-badge{display:inline-block;margin-bottom:22px;padding:5px 16px;border-radius:100px;background:rgba(0,229,255,.1);border:1px solid var(--border);font-family:'Space Mono',monospace;font-size:.68rem;color:var(--accent);letter-spacing:2px;text-transform:uppercase;}
.hero h1{font-size:clamp(2.2rem,5.5vw,4.6rem);font-weight:800;line-height:1.05;background:linear-gradient(135deg,#fff 30%,var(--accent) 70%,var(--accent2) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:18px;}
[data-theme=light] .hero h1{background:linear-gradient(135deg,#0f172a 30%,var(--accent) 70%,var(--accent2) 100%);-webkit-background-clip:text;background-clip:text;}
.hero p{font-size:1rem;color:var(--muted);max-width:540px;line-height:1.7;margin-bottom:36px;}
.hero-btns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;}
.btn{padding:12px 26px;border-radius:8px;font-size:.85rem;font-weight:600;cursor:pointer;border:none;transition:all .2s;text-decoration:none;display:inline-block;font-family:'Sora',sans-serif;}
.btn-primary{background:linear-gradient(135deg,var(--accent2),var(--accent));color:#fff;box-shadow:0 4px 20px rgba(0,229,255,.25);}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,229,255,.35);}
.btn-outline{background:transparent;color:var(--text);border:1px solid var(--border);}
.btn-outline:hover{border-color:var(--accent);color:var(--accent);}
.btn-sm{padding:8px 16px;font-size:.76rem;}
.stats-row{display:flex;gap:36px;justify-content:center;flex-wrap:wrap;margin-top:56px;padding-top:36px;border-top:1px solid var(--border);width:100%;}
.stat-num{font-family:'Space Mono',monospace;font-size:1.9rem;font-weight:700;color:var(--accent);}
.stat-label{font-size:.72rem;color:var(--muted);margin-top:3px;letter-spacing:1px;text-transform:uppercase;}
/* PROGRESS BANNER */
.prog-banner{background:var(--surface);border-bottom:1px solid var(--border);padding:12px 32px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
.prog-text{font-size:.8rem;color:var(--muted);}
.prog-text strong{color:var(--accent);}
.prog-bar-wrap{flex:1;min-width:140px;height:5px;background:var(--surface2);border-radius:100px;overflow:hidden;}
.prog-bar-fill{height:100%;background:linear-gradient(90deg,var(--accent2),var(--accent));border-radius:100px;transition:width .6s ease;}
.prog-badges{display:flex;gap:6px;flex-wrap:wrap;}
.prog-badge{padding:3px 10px;border-radius:100px;font-size:.65rem;font-weight:700;background:rgba(16,185,129,.12);color:var(--green);border:1px solid rgba(16,185,129,.25);}
/* SECTIONS */
section{padding:80px 24px;}
.container{max-width:1100px;margin:0 auto;}
.sec-label{font-family:'Space Mono',monospace;font-size:.68rem;color:var(--accent);letter-spacing:3px;text-transform:uppercase;margin-bottom:10px;}
.sec-title{font-size:clamp(1.7rem,3.5vw,2.6rem);font-weight:800;margin-bottom:14px;line-height:1.1;}
.sec-sub{color:var(--muted);font-size:.95rem;line-height:1.7;max-width:520px;margin-bottom:44px;}
/* LESSONS */
#lessons{background:var(--surface);}
.lesson-filter{display:flex;gap:7px;margin-bottom:26px;flex-wrap:wrap;}
.filter-btn{padding:6px 14px;border-radius:100px;font-size:.75rem;font-weight:600;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;transition:all .2s;font-family:'Sora',sans-serif;}
.filter-btn.active,.filter-btn:hover{background:var(--accent2);color:#fff;border-color:var(--accent2);}
.lessons-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:20px;}
.lesson-card{background:var(--surface2);border:1px solid var(--border);border-radius:16px;overflow:hidden;cursor:pointer;transition:transform .2s,border-color .2s,box-shadow .2s;position:relative;}
.lesson-card:hover{transform:translateY(-3px);border-color:var(--accent);box-shadow:0 10px 36px rgba(0,229,255,.12);}
.lesson-card.completed{border-color:var(--green);}
.lesson-card.completed::after{content:'✓ Done';position:absolute;top:9px;right:9px;background:var(--green);color:#fff;font-size:.62rem;font-weight:700;padding:3px 8px;border-radius:100px;}
.lesson-card.bookmarked::before{content:'🔖';position:absolute;top:9px;left:9px;font-size:.85rem;z-index:5;}
.lesson-thumb{width:100%;aspect-ratio:16/9;background:#000;overflow:hidden;position:relative;}
.lesson-thumb iframe{width:100%;height:100%;border:none;pointer-events:none;}
.play-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.4);transition:opacity .2s;}
.lesson-card:hover .play-overlay{opacity:0;}
.play-icon{width:48px;height:48px;border-radius:50%;background:rgba(0,229,255,.9);display:flex;align-items:center;justify-content:center;}
.lesson-body{padding:16px;}
.lesson-num{font-family:'Space Mono',monospace;font-size:.65rem;color:var(--accent2);letter-spacing:2px;text-transform:uppercase;margin-bottom:5px;}
.lesson-title{font-size:.97rem;font-weight:700;margin-bottom:5px;line-height:1.3;}
.lesson-desc{font-size:.8rem;color:var(--muted);line-height:1.6;margin-bottom:12px;}
.lesson-meta{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
.tag{padding:3px 9px;border-radius:100px;font-size:.65rem;font-weight:600;background:rgba(0,229,255,.1);color:var(--accent);border:1px solid rgba(0,229,255,.2);}
.tag.purple{background:rgba(124,58,237,.15);color:#a78bfa;border-color:rgba(124,58,237,.3);}
.tag.amber{background:rgba(245,158,11,.15);color:var(--accent3);border-color:rgba(245,158,11,.3);}
.duration{font-size:.7rem;color:var(--muted);margin-left:auto;}
.card-actions{display:flex;gap:5px;margin-top:10px;padding-top:10px;border-top:1px solid var(--border);}
.card-btn{flex:1;padding:6px;border-radius:7px;font-size:.7rem;font-weight:600;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;font-family:'Sora',sans-serif;transition:all .2s;}
.card-btn:hover{border-color:var(--accent);color:var(--accent);}
.card-btn.done-active{background:rgba(16,185,129,.1);border-color:var(--green);color:var(--green);}
.card-btn.bk-active{background:rgba(245,158,11,.1);border-color:var(--accent3);color:var(--accent3);}
/* SKELETON */
.skeleton{background:linear-gradient(90deg,var(--surface2) 25%,var(--surface) 50%,var(--surface2) 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:8px;}
@keyframes shimmer{0%{background-position:200% 0;}100%{background-position:-200% 0;}}
/* PLAYER */
#player-section{display:none;background:var(--bg);padding:60px 24px;}
#player-section.visible{display:block;}
.player-layout{display:grid;grid-template-columns:1fr 340px;gap:24px;max-width:1100px;margin:0 auto;align-items:start;}
.video-frame{border-radius:14px;overflow:hidden;background:#000;border:1px solid var(--border);aspect-ratio:16/9;}
.video-frame iframe{width:100%;height:100%;border:none;}
.video-title{font-size:1.25rem;font-weight:700;margin:18px 0 5px;}
.video-meta{font-size:.78rem;color:var(--muted);margin-bottom:13px;}
.video-desc{font-size:.86rem;color:var(--muted);line-height:1.7;padding:13px;background:var(--surface2);border-radius:9px;border:1px solid var(--border);margin-bottom:13px;}
.kp-title{font-size:.75rem;font-weight:700;color:var(--accent);letter-spacing:1px;text-transform:uppercase;margin-bottom:9px;}
.kp-item{display:flex;gap:7px;align-items:flex-start;margin-bottom:7px;font-size:.81rem;line-height:1.5;}
.kp-item::before{content:'▸';color:var(--accent);flex-shrink:0;margin-top:1px;}
.next-btn{width:100%;padding:12px;border-radius:9px;border:none;cursor:pointer;background:linear-gradient(135deg,var(--accent2),var(--accent));color:#fff;font-weight:700;font-size:.86rem;font-family:'Sora',sans-serif;margin-top:14px;}
/* NOTES */
#notes{background:var(--bg);}
.notes-layout{display:grid;grid-template-columns:230px 1fr;gap:24px;align-items:start;}
.notes-sidebar{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:16px;position:sticky;top:72px;}
.nsb-title{font-size:.67rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--accent);margin-bottom:13px;}
.note-tab{display:flex;align-items:center;gap:7px;padding:9px 11px;border-radius:9px;cursor:pointer;transition:all .2s;margin-bottom:2px;border:1px solid transparent;font-size:.8rem;color:var(--muted);}
.note-tab:hover{background:rgba(0,229,255,.05);color:var(--text);}
.note-tab.active{background:rgba(0,229,255,.1);border-color:var(--border);color:var(--accent);font-weight:600;}
.note-tab-num{font-family:'Space Mono',monospace;font-size:.62rem;color:var(--muted);margin-left:auto;}
.notes-content{display:none;animation:fadeUp .3s ease;}
.notes-content.active{display:block;}
.note-lvl-badge{display:inline-block;padding:3px 12px;border-radius:100px;font-size:.67rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:9px;}
.note-lvl-badge.beginner{background:rgba(0,229,255,.1);color:var(--accent);border:1px solid rgba(0,229,255,.2);}
.note-lvl-badge.intermediate{background:rgba(124,58,237,.15);color:#a78bfa;border:1px solid rgba(124,58,237,.3);}
.note-lvl-badge.advanced{background:rgba(245,158,11,.15);color:var(--accent3);border:1px solid rgba(245,158,11,.3);}
.note-title{font-size:1.65rem;font-weight:800;margin-bottom:7px;}
.note-intro{color:var(--muted);font-size:.9rem;line-height:1.7;margin-bottom:22px;}
.note-block{margin-bottom:26px;}
.note-block-title{font-size:.75rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--accent2);margin-bottom:11px;display:flex;align-items:center;gap:7px;}
.note-block-title::after{content:'';flex:1;height:1px;background:var(--border);}
.note-expl{font-size:.88rem;line-height:1.8;color:var(--muted);background:var(--surface2);border:1px solid var(--border);border-radius:11px;padding:16px 20px;margin-bottom:12px;}
.note-expl strong{color:var(--text);}
.note-expl em{color:var(--accent3);font-style:normal;font-weight:600;}
.code-block{background:#0d1117;border:1px solid rgba(0,229,255,.2);border-radius:11px;overflow:hidden;margin-bottom:12px;}
.code-header{display:flex;align-items:center;justify-content:space-between;padding:8px 13px;background:rgba(0,229,255,.05);border-bottom:1px solid rgba(0,229,255,.1);}
.code-lang{font-family:'Space Mono',monospace;font-size:.65rem;color:var(--accent);letter-spacing:1px;}
.copy-btn{font-size:.67rem;color:var(--muted);cursor:pointer;padding:3px 9px;border-radius:5px;border:1px solid var(--border);background:transparent;font-family:'Sora',sans-serif;transition:all .2s;}
.copy-btn:hover{color:var(--accent);border-color:var(--accent);}
.code-block pre{padding:16px 20px;overflow-x:auto;font-family:'Space Mono',monospace;font-size:.78rem;line-height:1.7;color:#e6edf3;margin:0;}
.kw{color:#ff7b72;}.fn{color:#d2a8ff;}.st{color:#a5d6ff;}.cm{color:#8b949e;font-style:italic;}.num{color:#79c0ff;}.cl{color:#ffa657;}
.tip-box{display:flex;gap:10px;padding:13px 16px;border-radius:9px;margin-bottom:12px;background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.25);}
.tip-box.warn{background:rgba(245,158,11,.07);border-color:rgba(245,158,11,.25);}
.tip-box.info{background:rgba(124,58,237,.07);border-color:rgba(124,58,237,.25);}
.tip-icon{font-size:.95rem;flex-shrink:0;margin-top:1px;}
.tip-text{font-size:.83rem;line-height:1.7;color:var(--muted);}
.tip-text strong{color:var(--text);}
.note-table{width:100%;border-collapse:collapse;margin-bottom:12px;font-size:.82rem;}
.note-table th{padding:8px 13px;text-align:left;background:rgba(0,229,255,.07);color:var(--accent);font-size:.7rem;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid var(--border);}
.note-table td{padding:8px 13px;border-bottom:1px solid rgba(0,229,255,.06);color:var(--muted);vertical-align:top;}
.note-table td code{font-family:'Space Mono',monospace;font-size:.76rem;color:var(--accent3);background:rgba(245,158,11,.08);padding:2px 5px;border-radius:4px;}
.note-table tr:last-child td{border-bottom:none;}
.dl-btn{display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:9px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:var(--green);font-size:.8rem;font-weight:600;cursor:pointer;transition:all .2s;margin-bottom:18px;font-family:'Sora',sans-serif;}
.dl-btn:hover{background:rgba(16,185,129,.2);}
.notes-nav{display:flex;gap:9px;margin-top:28px;padding-top:24px;border-top:1px solid var(--border);}
/* FORMS */
.form-group{margin-bottom:16px;}
.form-group label{display:block;font-size:.78rem;font-weight:600;margin-bottom:6px;color:var(--text);}
.form-group input,.form-group textarea,.form-group select{width:100%;padding:11px 13px;border-radius:9px;background:var(--bg);border:1px solid var(--border);color:var(--text);font-family:'Sora',sans-serif;font-size:.86rem;transition:border-color .2s;resize:vertical;}
.form-group input:focus,.form-group textarea:focus,.form-group select:focus{outline:none;border-color:var(--accent);}
.form-group select option{background:var(--bg);}
.submit-btn{padding:11px 28px;border-radius:9px;border:none;cursor:pointer;background:linear-gradient(135deg,var(--accent2),var(--accent));color:#fff;font-weight:700;font-size:.86rem;font-family:'Sora',sans-serif;transition:all .2s;}
.submit-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,229,255,.3);}
/* QA */
#qa{background:var(--surface);}
.qa-form{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:28px;max-width:660px;}
.qa-list{margin-top:32px;display:flex;flex-direction:column;gap:12px;max-width:660px;}
.qa-item{background:var(--surface2);border:1px solid var(--border);border-radius:11px;padding:16px;animation:fadeUp .4s ease;}
.qa-hdr{display:flex;align-items:center;gap:9px;margin-bottom:9px;flex-wrap:wrap;}
.qa-av{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--accent2),var(--accent));display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.8rem;color:#fff;flex-shrink:0;}
.qa-name{font-weight:600;font-size:.86rem;}
.qa-ltag{font-size:.65rem;color:var(--accent);background:rgba(0,229,255,.1);padding:2px 7px;border-radius:100px;}
.upvote-btn{margin-left:auto;display:flex;align-items:center;gap:4px;padding:3px 9px;border-radius:100px;border:1px solid var(--border);background:transparent;cursor:pointer;font-size:.72rem;color:var(--muted);font-family:'Sora',sans-serif;transition:all .2s;}
.upvote-btn:hover,.upvote-btn.voted{border-color:var(--accent3);color:var(--accent3);background:rgba(245,158,11,.08);}
.qa-q{font-size:.84rem;line-height:1.6;margin-bottom:9px;}
.qa-ans{background:rgba(0,229,255,.05);border-left:3px solid var(--accent);padding:9px 13px;border-radius:0 7px 7px 0;font-size:.81rem;line-height:1.6;color:var(--muted);}
.qa-ans strong{color:var(--accent);font-size:.68rem;display:block;margin-bottom:2px;letter-spacing:1px;}
/* QUIZ */
#quiz{background:var(--bg);}
.quiz-wrap{max-width:660px;}
.quiz-pills{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:24px;}
.q-pill{padding:6px 14px;border-radius:100px;font-size:.76rem;font-weight:600;border:1px solid var(--border);background:transparent;color:var(--muted);cursor:pointer;transition:all .2s;}
.q-pill.active,.q-pill:hover{background:var(--accent2);color:#fff;border-color:var(--accent2);}
.quiz-card{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:26px;}
.q-prog-text{font-size:.7rem;color:var(--muted);font-family:'Space Mono',monospace;}
.q-prog-bar{height:3px;background:var(--surface);border-radius:100px;overflow:hidden;margin:5px 0 18px;}
.q-prog-fill{height:100%;background:linear-gradient(90deg,var(--accent2),var(--accent));border-radius:100px;transition:width .5s ease;}
.q-question{font-size:1.02rem;font-weight:700;line-height:1.4;margin-bottom:18px;}
.q-options{display:flex;flex-direction:column;gap:9px;margin-bottom:18px;}
.q-opt{padding:12px 14px;border-radius:9px;border:1px solid var(--border);background:var(--bg);cursor:pointer;font-size:.86rem;color:var(--text);transition:all .2s;text-align:left;font-family:'Sora',sans-serif;display:flex;align-items:center;gap:9px;}
.q-opt:hover:not(:disabled){border-color:var(--accent);background:rgba(0,229,255,.05);}
.q-opt.correct{border-color:var(--green);background:rgba(16,185,129,.1);color:var(--green);}
.q-opt.wrong{border-color:var(--red);background:rgba(239,68,68,.1);color:var(--red);}
.opt-letter{width:24px;height:24px;border-radius:5px;background:var(--surface);display:flex;align-items:center;justify-content:center;font-family:'Space Mono',monospace;font-size:.68rem;font-weight:700;flex-shrink:0;}
.q-feedback{padding:13px;border-radius:9px;font-size:.84rem;line-height:1.6;display:none;margin-bottom:16px;}
.q-feedback.correct-fb{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:var(--green);display:block;}
.q-feedback.wrong-fb{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#fca5a5;display:block;}
.score-view{text-align:center;padding:26px;display:none;}
.score-circle{width:100px;height:100px;border-radius:50%;background:conic-gradient(var(--accent) var(--pct),var(--surface) 0);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;}
.score-inner{width:74px;height:74px;border-radius:50%;background:var(--surface2);display:flex;align-items:center;justify-content:center;font-family:'Space Mono',monospace;font-size:1.1rem;font-weight:700;color:var(--accent);}
.wa-share{padding:9px 20px;border-radius:100px;border:1px solid rgba(37,211,102,.4);background:rgba(37,211,102,.1);color:#25d366;font-weight:600;font-size:.8rem;font-family:'Sora',sans-serif;cursor:pointer;margin-right:8px;transition:all .2s;}
.wa-share:hover{background:rgba(37,211,102,.2);}
/* QUIZ HISTORY */
.quiz-history{margin-top:22px;}
.qh-title{font-size:.75rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:10px;}
.qh-item{display:flex;align-items:center;gap:12px;padding:9px 13px;background:var(--surface2);border:1px solid var(--border);border-radius:9px;margin-bottom:7px;font-size:.81rem;}
.qh-score{font-family:'Space Mono',monospace;font-weight:700;color:var(--accent);min-width:36px;}
.qh-topic{flex:1;color:var(--muted);}
.qh-date{font-size:.7rem;color:var(--muted);}
.qh-pct{padding:2px 9px;border-radius:100px;font-size:.67rem;font-weight:700;}
/* LEADERBOARD */
#leaderboard{background:var(--surface);}
.lb-wrap{background:var(--surface2);border:1px solid var(--border);border-radius:14px;overflow:hidden;max-width:660px;}
.lb-hdr{display:grid;grid-template-columns:56px 1fr 90px 100px;padding:10px 18px;background:rgba(0,229,255,.07);border-bottom:1px solid var(--border);font-size:.68rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--accent);}
.lb-row{display:grid;grid-template-columns:56px 1fr 90px 100px;padding:12px 18px;border-bottom:1px solid var(--border);align-items:center;font-size:.86rem;transition:background .2s;}
.lb-row:last-child{border-bottom:none;}
.lb-row:hover{background:rgba(0,229,255,.03);}
.lb-rank{font-family:'Space Mono',monospace;font-weight:700;}
.lb-rank.gold{color:var(--accent3);font-size:1.05rem;}
.lb-rank.silver{color:#94a3b8;}
.lb-rank.bronze{color:#cd7c4b;}
.lb-score-val{font-family:'Space Mono',monospace;color:var(--accent);font-weight:700;}
.lb-topic{font-size:.72rem;color:var(--muted);}
/* DAILY CHALLENGE */
#daily{background:var(--bg);}
.challenge-card{background:linear-gradient(135deg,rgba(124,58,237,.12),rgba(0,229,255,.06));border:1px solid var(--border);border-radius:18px;padding:32px;max-width:760px;position:relative;overflow:hidden;}
.ch-meta{display:flex;gap:10px;align-items:center;margin-bottom:18px;flex-wrap:wrap;}
.ch-day{font-family:'Space Mono',monospace;font-size:.67rem;color:var(--accent);letter-spacing:2px;text-transform:uppercase;}
.ch-diff{padding:3px 9px;border-radius:100px;font-size:.65rem;font-weight:700;}
.d-easy{background:rgba(16,185,129,.15);color:var(--green);border:1px solid rgba(16,185,129,.3);}
.d-medium{background:rgba(245,158,11,.15);color:var(--accent3);border:1px solid rgba(245,158,11,.3);}
.d-hard{background:rgba(239,68,68,.15);color:var(--red);border:1px solid rgba(239,68,68,.3);}
.xp-tag{display:inline-flex;align-items:center;gap:5px;padding:3px 11px;border-radius:100px;background:rgba(0,229,255,.1);border:1px solid var(--border);font-size:.68rem;color:var(--accent);font-weight:700;}
.ch-q{font-size:1.08rem;font-weight:700;line-height:1.4;margin-bottom:20px;}
.ch-editor{width:100%;min-height:110px;background:#0d1117;border:1px solid rgba(0,229,255,.2);border-radius:11px;padding:14px;font-family:'Space Mono',monospace;font-size:.82rem;color:#e6edf3;resize:vertical;outline:none;}
.ch-editor:focus{border-color:var(--accent);}
.ch-btns{display:flex;gap:9px;margin-top:12px;flex-wrap:wrap;}
.run-btn{padding:9px 20px;border-radius:7px;background:linear-gradient(135deg,var(--accent2),var(--accent));color:#fff;border:none;cursor:pointer;font-weight:700;font-size:.82rem;font-family:'Sora',sans-serif;}
.hint-btn{padding:9px 16px;border-radius:7px;background:transparent;color:var(--accent3);border:1px solid rgba(245,158,11,.3);cursor:pointer;font-weight:600;font-size:.82rem;font-family:'Sora',sans-serif;}
.ch-hint{margin-top:11px;padding:11px 14px;background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.2);border-radius:9px;font-size:.83rem;color:var(--accent3);display:none;}
.ch-hint.visible{display:block;}
.ch-output{margin-top:11px;padding:13px;background:#0d1117;border-radius:9px;border:1px solid rgba(0,229,255,.15);font-family:'Space Mono',monospace;font-size:.8rem;color:#e6edf3;min-height:38px;display:none;white-space:pre-wrap;}
.ch-output.visible{display:block;}
/* PLAYGROUND */
#playground{background:var(--surface);}
.pg-layout{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:1100px;}
.pg-panel{background:var(--surface2);border:1px solid var(--border);border-radius:14px;overflow:hidden;}
.pg-header{display:flex;align-items:center;justify-content:space-between;padding:11px 16px;background:rgba(0,229,255,.05);border-bottom:1px solid var(--border);}
.pg-title{font-family:'Space Mono',monospace;font-size:.68rem;color:var(--accent);letter-spacing:2px;text-transform:uppercase;}
.pg-actions{display:flex;gap:7px;}
.run-code-btn{padding:7px 18px;border-radius:7px;background:linear-gradient(135deg,var(--accent2),var(--accent));color:#fff;border:none;cursor:pointer;font-weight:700;font-size:.77rem;font-family:'Sora',sans-serif;transition:opacity .2s;}
.run-code-btn:hover{opacity:.85;}
.clear-btn{padding:7px 14px;border-radius:7px;background:transparent;color:var(--muted);border:1px solid var(--border);cursor:pointer;font-size:.77rem;font-family:'Sora',sans-serif;}
.py-editor{width:100%;height:300px;background:#0d1117;border:none;padding:16px;font-family:'Space Mono',monospace;font-size:.82rem;color:#e6edf3;resize:none;outline:none;}
.py-output{height:300px;padding:16px;font-family:'Space Mono',monospace;font-size:.8rem;color:#e6edf3;overflow-y:auto;white-space:pre-wrap;background:#060a12;}
.snippets{display:flex;gap:7px;flex-wrap:wrap;padding:11px 16px;border-top:1px solid var(--border);}
.snip-btn{padding:4px 11px;border-radius:5px;background:rgba(124,58,237,.12);border:1px solid rgba(124,58,237,.25);color:#a78bfa;font-size:.68rem;cursor:pointer;font-family:'Sora',sans-serif;transition:all .2s;}
.snip-btn:hover{background:rgba(124,58,237,.25);}
/* REVIEWS */
#reviews{background:var(--bg);}
.reviews-layout{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start;}
.review-form{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:26px;}
.star-row{display:flex;gap:6px;margin-bottom:4px;}
.star{font-size:1.6rem;cursor:pointer;transition:transform .15s;filter:grayscale(1) opacity(.4);}
.star.active{filter:none;transform:scale(1.12);}
.reviews-list{display:flex;flex-direction:column;gap:12px;}
.review-card{background:var(--surface2);border:1px solid var(--border);border-radius:11px;padding:16px;animation:fadeUp .4s ease;}
.rev-hdr{display:flex;align-items:center;gap:9px;margin-bottom:10px;}
.rev-av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--accent3),var(--accent2));display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:.86rem;flex-shrink:0;}
.rev-name{font-weight:700;font-size:.86rem;}
.rev-stars{color:var(--accent3);font-size:.84rem;}
.rev-lesson{font-size:.68rem;color:var(--muted);}
.rev-text{font-size:.84rem;line-height:1.7;color:var(--muted);}
/* PROFILE MODAL */
#profile-modal{display:none;position:fixed;inset:0;z-index:400;background:rgba(0,0,0,.75);backdrop-filter:blur(8px);align-items:center;justify-content:center;}
#profile-modal.open{display:flex;}
.profile-card{background:var(--surface2);border:1px solid var(--border);border-radius:18px;padding:32px;width:90%;max-width:460px;max-height:90vh;overflow-y:auto;}
.profile-card h3{font-size:1.25rem;font-weight:800;margin-bottom:22px;}
.avatar-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:8px;margin-bottom:18px;}
.av-opt{font-size:1.5rem;cursor:pointer;text-align:center;padding:7px;border-radius:9px;border:2px solid transparent;transition:all .2s;}
.av-opt:hover,.av-opt.selected{border-color:var(--accent);background:rgba(0,229,255,.08);}
/* CERT MODAL */
#cert-modal{display:none;position:fixed;inset:0;z-index:400;background:rgba(0,0,0,.88);backdrop-filter:blur(8px);align-items:center;justify-content:center;}
#cert-modal.open{display:flex;}
.cert-wrap{background:var(--surface2);border-radius:18px;padding:20px;width:95%;max-width:800px;}
#cert-canvas{width:100%;border-radius:10px;display:block;}
.cert-actions{display:flex;gap:10px;margin-top:14px;justify-content:center;flex-wrap:wrap;}
/* CONFETTI */
#confetti-canvas{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:998;display:none;}
/* STREAK POPUP */
.streak-popup{position:fixed;top:72px;right:20px;z-index:300;background:var(--surface2);border:1px solid var(--accent3);border-radius:12px;padding:14px 18px;display:none;animation:fadeUp .3s ease;gap:10px;align-items:center;}
.streak-popup.show{display:flex;}
/* MANAGER */
#manager{background:var(--surface);padding:80px 24px;}
/* FOOTER */
footer{border-top:1px solid var(--border);padding:24px 32px;display:flex;align-items:center;justify-content:space-between;background:var(--bg);flex-wrap:wrap;gap:10px;}
footer p{font-size:.74rem;color:var(--muted);}
/* TOAST */
.toast{position:fixed;bottom:70px;right:20px;z-index:999;padding:11px 18px;border-radius:9px;background:var(--surface2);border:1px solid var(--green);color:var(--green);font-size:.84rem;font-weight:600;transform:translateY(80px);opacity:0;transition:all .3s ease;max-width:280px;}
.toast.show{transform:translateY(0);opacity:1;}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}
.fade-up{animation:fadeUp .5s ease both;}
@media(max-width:900px){
  nav{padding:10px 16px;}
  nav ul{display:none;}
  .hamburger{display:flex;}
  .player-layout{grid-template-columns:1fr;}
  .reviews-layout{grid-template-columns:1fr;}
  .notes-layout{grid-template-columns:1fr;}
  .notes-sidebar{position:static;}
  .pg-layout{grid-template-columns:1fr;}
  section{padding:60px 18px;}
  #manager{padding:60px 18px;}
}
@media(max-width:600px){
  .lb-hdr,.lb-row{grid-template-columns:50px 1fr 80px;}
  .lb-topic{display:none;}
  .stats-row{gap:20px;}
}


/* ACHIEVEMENTS */
#achievements{background:var(--bg);}
.ach-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;}
.ach-card{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:20px;text-align:center;transition:all .2s;position:relative;overflow:hidden;}
.ach-card.unlocked{border-color:var(--accent3);box-shadow:0 0 20px rgba(245,158,11,.12);}
.ach-card.locked{opacity:.45;filter:grayscale(.6);}
.ach-icon{font-size:2.2rem;margin-bottom:10px;display:block;}
.ach-name{font-size:.88rem;font-weight:700;margin-bottom:5px;}
.ach-desc{font-size:.74rem;color:var(--muted);line-height:1.5;}
.ach-badge{position:absolute;top:9px;right:9px;width:18px;height:18px;border-radius:50%;background:var(--green);display:flex;align-items:center;justify-content:center;font-size:.6rem;color:#fff;}
/* PROJECTS */
#projects{background:var(--surface);}
.proj-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:20px;}
.proj-card{background:var(--surface2);border:1px solid var(--border);border-radius:14px;overflow:hidden;transition:all .2s;}
.proj-card:hover{border-color:var(--accent);transform:translateY(-3px);box-shadow:0 10px 30px rgba(0,229,255,.1);}
.proj-banner{height:90px;display:flex;align-items:center;justify-content:center;font-size:2.8rem;}
.proj-body{padding:18px;}
.proj-title{font-size:1rem;font-weight:700;margin-bottom:6px;}
.proj-desc{font-size:.8rem;color:var(--muted);line-height:1.6;margin-bottom:14px;}
.proj-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
.proj-tag{padding:2px 8px;border-radius:100px;font-size:.66rem;font-weight:600;background:rgba(124,58,237,.12);color:#a78bfa;border:1px solid rgba(124,58,237,.25);}
.proj-diff{padding:3px 10px;border-radius:100px;font-size:.67rem;font-weight:700;}
.proj-steps{margin-top:14px;display:none;}
.proj-steps.open{display:block;}
.proj-step{padding:10px 13px;border-radius:8px;border:1px solid var(--border);margin-bottom:7px;font-size:.82rem;line-height:1.5;}
.proj-step-num{font-family:'Space Mono',monospace;font-size:.65rem;color:var(--accent);display:block;margin-bottom:3px;}
/* CHEAT SHEET */
#cheatsheet{background:var(--bg);}
.cs-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px;}
.cs-card{background:var(--surface2);border:1px solid var(--border);border-radius:12px;overflow:hidden;}
.cs-card-title{padding:11px 16px;background:rgba(0,229,255,.07);border-bottom:1px solid var(--border);font-size:.78rem;font-weight:700;color:var(--accent);letter-spacing:1px;text-transform:uppercase;}
.cs-card pre{padding:14px 16px;font-family:'Space Mono',monospace;font-size:.75rem;line-height:1.7;color:#e6edf3;background:#0d1117;margin:0;overflow-x:auto;white-space:pre-wrap;}
/* HEATMAP */
#heatmap-section{background:var(--surface);}
.heatmap-wrap{overflow-x:auto;}
.heatmap-grid{display:flex;gap:3px;align-items:flex-start;}
.hm-col{display:flex;flex-direction:column;gap:3px;}
.hm-cell{width:13px;height:13px;border-radius:2px;cursor:pointer;transition:transform .1s;}
.hm-cell:hover{transform:scale(1.3);}
.hm-0{background:var(--surface2);border:1px solid var(--border);}
.hm-1{background:rgba(0,229,255,.25);}
.hm-2{background:rgba(0,229,255,.5);}
.hm-3{background:rgba(0,229,255,.75);}
.hm-4{background:var(--accent);}
.hm-months{display:flex;gap:3px;margin-bottom:4px;font-size:.62rem;color:var(--muted);font-family:'Space Mono',monospace;}
.hm-days{display:flex;flex-direction:column;gap:3px;margin-right:6px;font-size:.6rem;color:var(--muted);font-family:'Space Mono',monospace;}
.hm-legend{display:flex;align-items:center;gap:5px;margin-top:10px;font-size:.72rem;color:var(--muted);}
.hm-legend-cell{width:12px;height:12px;border-radius:2px;}
/* STUDY TIMER */
.timer-widget{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:14px 18px;display:flex;align-items:center;gap:14px;max-width:400px;margin-bottom:20px;}
.timer-display{font-family:'Space Mono',monospace;font-size:1.5rem;font-weight:700;color:var(--accent);}
.timer-btns{display:flex;gap:7px;}
.tbtn{padding:6px 14px;border-radius:7px;border:1px solid var(--border);background:transparent;color:var(--muted);font-size:.76rem;cursor:pointer;font-family:'Sora',sans-serif;transition:all .2s;}
.tbtn:hover{border-color:var(--accent);color:var(--accent);}
.tbtn.active{background:var(--green);border-color:var(--green);color:#fff;}
/* WEEKLY REPORT */
.weekly-report{background:var(--surface2);border:1px solid var(--border);border-radius:14px;padding:22px;max-width:660px;margin-top:20px;}
.wr-title{font-size:.75rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--accent);margin-bottom:16px;}
.wr-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px;}
.wr-stat{text-align:center;padding:12px;background:var(--surface);border-radius:10px;border:1px solid var(--border);}
.wr-num{font-family:'Space Mono',monospace;font-size:1.4rem;font-weight:700;color:var(--accent);}
.wr-label{font-size:.68rem;color:var(--muted);margin-top:2px;text-transform:uppercase;letter-spacing:1px;}
/* LEARNER WALL */
#learner-wall{background:var(--surface);}
.wall-feed{display:flex;flex-direction:column;gap:10px;max-width:660px;}
.wall-item{background:var(--surface2);border:1px solid var(--border);border-radius:11px;padding:14px;display:flex;gap:12px;align-items:flex-start;animation:fadeUp .4s ease;}
.wall-av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--accent2),var(--accent3));display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;}
.wall-text{font-size:.84rem;line-height:1.5;}
.wall-time{font-size:.68rem;color:var(--muted);margin-top:3px;}
/* SHARE MODAL */
#share-modal{display:none;position:fixed;inset:0;z-index:400;background:rgba(0,0,0,.75);backdrop-filter:blur(8px);align-items:center;justify-content:center;}
#share-modal.open{display:flex;}
.share-card{background:var(--surface2);border:1px solid var(--border);border-radius:18px;padding:28px;width:90%;max-width:400px;text-align:center;}
.share-card h3{font-size:1.1rem;font-weight:800;margin-bottom:18px;}
.share-btns{display:flex;flex-direction:column;gap:10px;}
.share-opt{padding:12px 20px;border-radius:10px;border:none;cursor:pointer;font-weight:600;font-size:.86rem;font-family:'Sora',sans-serif;transition:all .2s;display:flex;align-items:center;gap:10px;justify-content:center;}
.share-wa{background:rgba(37,211,102,.15);border:1px solid rgba(37,211,102,.3);color:#25d366;}
.share-wa:hover{background:rgba(37,211,102,.25);}
.share-copy{background:rgba(0,229,255,.1);border:1px solid var(--border);color:var(--accent);}
.share-copy:hover{background:rgba(0,229,255,.2);}
.share-x{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);color:var(--text);}
.share-x:hover{background:rgba(255,255,255,.15);}
@media(max-width:900px){
  .review-layout{grid-template-columns:1fr;}
  .wr-stats{grid-template-columns:1fr 1fr;}
}


/* TIMED QUIZ */
.timed-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:100px;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.3);color:var(--red);font-size:.72rem;font-weight:700;}
.quiz-timer-bar{height:4px;background:var(--surface2);border-radius:100px;overflow:hidden;margin-bottom:14px;}
.quiz-timer-fill{height:100%;background:linear-gradient(90deg,var(--green),var(--accent3),var(--red));border-radius:100px;transition:width .5s linear;}
.timed-toggle{display:flex;align-items:center;gap:10px;margin-bottom:18px;background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:10px 14px;}
.toggle-switch{position:relative;width:38px;height:20px;cursor:pointer;}
.toggle-switch input{opacity:0;width:0;height:0;}
.toggle-slider{position:absolute;inset:0;background:var(--surface);border-radius:100px;border:1px solid var(--border);transition:.3s;}
.toggle-slider::before{content:'';position:absolute;height:14px;width:14px;left:2px;bottom:2px;background:var(--muted);border-radius:50%;transition:.3s;}
.toggle-switch input:checked+.toggle-slider{background:var(--accent2);border-color:var(--accent2);}
.toggle-switch input:checked+.toggle-slider::before{transform:translateX(18px);background:#fff;}
/* GLOSSARY */
#glossary{background:var(--surface);}
.glossary-search{width:100%;max-width:440px;padding:11px 16px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--text);font-family:'Sora',sans-serif;font-size:.9rem;outline:none;margin-bottom:20px;}
.glossary-search:focus{border-color:var(--accent);}
.glossary-letters{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:20px;}
.gl-letter{padding:4px 10px;border-radius:6px;font-size:.75rem;font-weight:700;cursor:pointer;border:1px solid var(--border);background:transparent;color:var(--muted);font-family:'Space Mono',monospace;transition:all .2s;}
.gl-letter:hover,.gl-letter.active{background:var(--accent2);color:#fff;border-color:var(--accent2);}
.glossary-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;}
.glossary-item{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:16px;animation:fadeUp .3s ease;}
.gl-term{font-size:.95rem;font-weight:700;color:var(--accent);margin-bottom:5px;font-family:'Space Mono',monospace;}
.gl-def{font-size:.82rem;color:var(--muted);line-height:1.6;}
.gl-example{margin-top:8px;font-family:'Space Mono',monospace;font-size:.75rem;background:#0d1117;padding:8px 12px;border-radius:7px;color:#a5d6ff;border:1px solid rgba(0,229,255,.1);}
/* COMMON ERRORS */
#errors{background:var(--bg);}
.error-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:18px;}
.error-card{background:var(--surface2);border:1px solid var(--border);border-radius:14px;overflow:hidden;transition:all .2s;}
.error-card:hover{border-color:var(--red);transform:translateY(-2px);}
.error-header{padding:14px 18px;display:flex;align-items:center;gap:10px;border-bottom:1px solid var(--border);}
.error-badge{padding:3px 10px;border-radius:100px;font-size:.68rem;font-weight:700;background:rgba(239,68,68,.12);color:var(--red);border:1px solid rgba(239,68,68,.3);font-family:'Space Mono',monospace;}
.error-name{font-size:.92rem;font-weight:700;}
.error-body{padding:14px 18px;}
.error-cause{font-size:.82rem;color:var(--muted);line-height:1.6;margin-bottom:10px;}
.error-fix{font-size:.8rem;color:var(--green);background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.2);border-radius:8px;padding:9px 12px;}
/* DEBUG SECTION */
#debug{background:var(--surface);}
.debug-wrap{max-width:900px;}
.debug-card{background:var(--surface2);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:20px;}
.debug-header{padding:14px 18px;background:rgba(239,68,68,.07);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
.debug-label{font-size:.68rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--red);}
.debug-title{font-size:.95rem;font-weight:700;margin-top:3px;}
.debug-diff{padding:3px 10px;border-radius:100px;font-size:.65rem;font-weight:700;}
.debug-body{padding:18px;}
.debug-desc{font-size:.85rem;color:var(--muted);margin-bottom:14px;line-height:1.6;}
.debug-hint-btn{padding:7px 14px;border-radius:7px;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25);color:var(--accent3);font-size:.78rem;font-weight:600;cursor:pointer;font-family:'Sora',sans-serif;transition:all .2s;}
.debug-hint-btn:hover{background:rgba(245,158,11,.2);}
.debug-hint{margin-top:11px;padding:10px 14px;background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.2);border-radius:8px;font-size:.82rem;color:var(--accent3);display:none;}
.debug-hint.show{display:block;}
.debug-result{margin-top:11px;padding:12px;background:#0d1117;border-radius:9px;font-family:'Space Mono',monospace;font-size:.8rem;min-height:36px;display:none;white-space:pre-wrap;}
.debug-result.show{display:block;}
/* PWA INSTALL */
.pwa-banner{display:none;position:fixed;bottom:70px;left:50%;transform:translateX(-50%);z-index:300;background:var(--surface2);border:1px solid var(--accent);border-radius:14px;padding:14px 20px;display:flex;align-items:center;gap:14px;box-shadow:0 8px 32px rgba(0,229,255,.2);max-width:400px;width:90%;}
.pwa-banner.hidden{display:none!important;}
.pwa-install-btn{padding:9px 18px;border-radius:8px;background:linear-gradient(135deg,var(--accent2),var(--accent));color:#fff;border:none;cursor:pointer;font-weight:700;font-size:.82rem;font-family:'Sora',sans-serif;white-space:nowrap;}
.pwa-dismiss{background:transparent;border:none;color:var(--muted);cursor:pointer;font-size:1.1rem;padding:4px;}
/* LOGIN BONUS */
.login-bonus-popup{position:fixed;top:72px;left:50%;transform:translateX(-50%);z-index:400;background:linear-gradient(135deg,var(--accent2),var(--accent));color:#fff;border-radius:14px;padding:18px 28px;text-align:center;display:none;animation:fadeUp .4s ease;box-shadow:0 8px 32px rgba(0,229,255,.35);}
.login-bonus-popup.show{display:block;}
</style>
</head>
