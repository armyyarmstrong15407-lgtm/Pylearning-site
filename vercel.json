var timedMode = false;
var quizTimerInterval = null;
var quizTimeLeft = 30;
function toggleTimedMode() {
  timedMode = document.getElementById('timedMode').checked;
  document.getElementById('timedBadge').style.display = timedMode ? 'inline-flex' : 'none';
  document.getElementById('quizTimerBar').style.display = timedMode ? 'block' : 'none';
}
function startQuizTimer() {
  clearInterval(quizTimerInterval);
  if (!timedMode) return;
  quizTimeLeft = 30;
  updateTimerBar();
  quizTimerInterval = setInterval(function() {
    quizTimeLeft--;
    updateTimerBar();
    if (quizTimeLeft <= 0) {
      clearInterval(quizTimerInterval);
      // Auto-select wrong answer to penalise timeout
      showToast('⏰ Time up!');
      var opts = document.querySelectorAll('#qOptions .q-opt');
      if (opts.length && !answered) {
        opts.forEach(function(o){ o.disabled = true; });
        var fb = document.getElementById('qFeedback');
        fb.className = 'q-feedback wrong-fb';
        fb.textContent = '⏰ Time ran out! ' + (quizQs[quizIdx] ? quizQs[quizIdx].e : '');
        document.getElementById('qNextBtn').style.display = 'inline-block';
        answered = true;
      }
    }
  }, 1000);
}
function updateTimerBar() {
  var pct = (quizTimeLeft / 30) * 100;
  document.getElementById('quizTimerFill').style.width = pct + '%';
}
// Patch nextQuestion to also start timer
var _origNextQuestion = nextQuestion;
nextQuestion = function() {
  clearInterval(quizTimerInterval);
  _origNextQuestion();
  startQuizTimer();
};
var _origStartQuiz = startQuiz;
startQuiz = function(topic, btn) {
  clearInterval(quizTimerInterval);
  _origStartQuiz(topic, btn);
  startQuizTimer();
};
var _origRestartQuiz = restartQuiz;
restartQuiz = function() {
  clearInterval(quizTimerInterval);
  _origRestartQuiz();
};
</script>

